@@ -0,0 +1,85 @@
+# -*- coding: utf-8 -*-
+from __future__ import absolute_import
+
+import os
+import ssl
+import stat
+import threading
+
+from django.core.exceptions import ImproperlyConfigured
+
+from . import conf
+
+_CIPHERS = "ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:DHE+CHACHA20:!aNULL:!eNULL:!MD5:!DSS"
+
+_lock = threading.Lock()
+_cache = {"stamp": None, "context": None}
+
+
+class TLSError(Exception):
+    pass
+
+
+def _refuse_password():
+    raise TLSError("the client private key is encrypted")
+
+
+def _stat(path, secret):
+    try:
+        st = os.stat(path)
+    except OSError as e:
+        raise TLSError("%s: %s" % (path, e.strerror))
+    if not stat.S_ISREG(st.st_mode) or not os.access(path, os.R_OK):
+        raise TLSError("%s is not a readable regular file" % path)
+    unsafe = stat.S_IRWXO | stat.S_IWGRP | stat.S_IXGRP if secret else stat.S_IWOTH | stat.S_IWGRP
+    if st.st_mode & unsafe:
+        raise TLSError("%s has unsafe permissions %04o" % (path, st.st_mode & 0o7777))
+    return path, st.st_ino, st.st_size, st.st_mtime
+
+
+def _stamp(cfg):
+    return (_stat(cfg.ca_file, False), _stat(cfg.client_cert, cfg.client_cert == cfg.client_key),
+            _stat(cfg.client_key, True))
+
+
+def _context(cfg, check_hostname, load_ca):
+    if not getattr(ssl, "HAS_SNI", False):
+        raise TLSError("the ssl module does not support SNI (%s)" % ssl.OPENSSL_VERSION)
+    context = ssl.SSLContext(getattr(ssl, "PROTOCOL_TLS", ssl.PROTOCOL_SSLv23))
+    context.options |= (ssl.OP_NO_SSLv2 | ssl.OP_NO_SSLv3 | ssl.OP_NO_TLSv1 | ssl.OP_NO_TLSv1_1
+                        | getattr(ssl, "OP_NO_COMPRESSION", 0))
+    try:
+        context.set_ciphers(_CIPHERS)
+        context.verify_mode = ssl.CERT_REQUIRED
+        context.check_hostname = check_hostname
+        if load_ca:
+            context.load_verify_locations(cafile=cfg.ca_file)
+        context.load_cert_chain(cfg.client_cert, cfg.client_key, password=_refuse_password)
+    except (ssl.SSLError, IOError, OSError) as e:
+        raise TLSError("cannot load TLS material (ca=%s cert=%s key=%s): %s"
+                       % (cfg.ca_file, cfg.client_cert, cfg.client_key, e))
+    return context
+
+
+def boto_context():
+    cfg = conf.get()
+    stamp = _stamp(cfg)
+    with _lock:
+        if _cache["stamp"] != stamp:
+            _cache["context"] = _context(cfg, check_hostname=True, load_ca=True)
+            _cache["stamp"] = stamp
+        return _cache["context"]
+
+
+def requests_context():
+    cfg = conf.get()
+    _stamp(cfg)
+    return _context(cfg, check_hostname=False, load_ca=False)
+
+
+def check():
+    try:
+        boto_context()
+        requests_context()
+    except TLSError as e:
+        raise ImproperlyConfigured("ozone_s3_creds: %s" % e)
