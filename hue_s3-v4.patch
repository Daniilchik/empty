@@ -0,0 +1,46 @@
+# -*- coding: utf-8 -*-
+from __future__ import absolute_import
+
+import logging
+
+from django.contrib.auth.signals import user_logged_in, user_logged_out
+from django.db import transaction
+from django.dispatch import receiver
+
+log = logging.getLogger(__name__)
+
+
+def _after_commit(action, username, *args):
+    def run():
+        try:
+            action(*args)
+        except Exception:
+            log.exception("ozone_s3_creds: %s failed for user=%s", action.__name__, username)
+    transaction.on_commit(run)
+
+
+@receiver(user_logged_in)
+def provision_on_login(sender, request, user, **kwargs):
+    from . import service
+    username = user.get_username()
+    try:
+        password = request.POST.get("password") if request is not None and request.method == "POST" else None
+        if not password:
+            log.info("ozone_s3_creds: no password in login request for user=%s, provisioning skipped", username)
+            return
+        _after_commit(service.provision, username, service.session_key(request), username, password)
+    except Exception:
+        log.exception("ozone_s3_creds: login handling failed for user=%s", username)
+
+
+@receiver(user_logged_out)
+def revoke_on_logout(sender, request, user, **kwargs):
+    from . import service
+    if user is None:
+        return
+    username = user.get_username()
+    try:
+        session = getattr(request, "session", None)
+        _after_commit(service.logout, username, getattr(session, "session_key", None), username)
+    except Exception:
+        log.exception("ozone_s3_creds: logout handling failed for user=%s", username)
