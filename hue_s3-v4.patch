@@ -0,0 +1,70 @@
+# -*- coding: utf-8 -*-
+from __future__ import absolute_import
+
+import threading
+
+import gssapi
+
+from . import conf
+
+_ADMIN_MIN_REMAINING = 300
+
+_lock = threading.Lock()
+_user_creds = {}
+_admin = {"creds": None}
+
+
+def kinit(username, password):
+    cfg = conf.get()
+    name = gssapi.Name("%s@%s" % (username, cfg.realm), gssapi.NameType.kerberos_principal)
+    secret = password.encode("utf-8") if not isinstance(password, bytes) else password
+    result = gssapi.raw.acquire_cred_with_password(name, secret, usage="initiate")
+    return gssapi.Credentials(base=result.creds)
+
+
+def principal(username):
+    return "%s@%s" % (username, conf.get().realm)
+
+
+def remaining(creds):
+    try:
+        lifetime = creds.lifetime
+    except gssapi.exceptions.GSSError:
+        return 0
+    return lifetime if lifetime is not None else 0
+
+
+def remember(username, creds):
+    with _lock:
+        _user_creds[username] = creds
+
+
+def forget(username, creds=None):
+    with _lock:
+        if creds is None or _user_creds.get(username) is creds:
+            _user_creds.pop(username, None)
+
+
+def known_users():
+    with _lock:
+        return list(_user_creds)
+
+
+def user_creds(username, min_remaining):
+    with _lock:
+        creds = _user_creds.get(username)
+    if creds is not None and remaining(creds) >= min_remaining:
+        return creds
+    return None
+
+
+def admin_creds():
+    cfg = conf.get()
+    with _lock:
+        creds = _admin["creds"]
+        if creds is None or remaining(creds) < _ADMIN_MIN_REMAINING:
+            name = gssapi.Name(cfg.admin_principal, gssapi.NameType.kerberos_principal)
+            store = {"client_keytab": cfg.admin_keytab, "ccache": "MEMORY:ozone_s3_creds_admin"}
+            creds = gssapi.Credentials(name=name, usage="initiate", store=store)
+            _admin["creds"] = creds
+        return creds
