new file mode 100644
index 0000000..ddf522c
--- /dev/null
+++ b/component-hue/docker/ozone_s3_creds/patch.py
@@ -0,0 +1,194 @@
+# -*- coding: utf-8 -*-
+from __future__ import absolute_import
+
+import logging
+import ssl
+from importlib import import_module
+
+from django.core.exceptions import ImproperlyConfigured
+
+from . import conf, tls
+
+log = logging.getLogger(__name__)
+
+_MARK = "_ozone_s3_creds_patched"
+_S3_PERMISSION = "s3_access"
+_PROXY_KWARGS = ("proxy", "proxy_port", "proxy_user", "proxy_pass")
+_MAX_RETRIES = 2
+_PERMANENT_TLS = ("certificate_verify_failed", "certificate verify failed", "unknown_ca", "unknown ca",
+                  "bad_certificate", "bad certificate", "certificate_required", "certificate required",
+                  "no_shared_cipher", "no shared cipher", "wrong_version_number", "wrong version number")
+
+
+class _PermanentTLSErrorType(type):
+
+    def __instancecheck__(cls, error):
+        if not isinstance(error, ssl.SSLError):
+            return False
+        text = ("%s %s" % (getattr(error, "reason", None) or "", error)).lower()
+        return any(marker in text for marker in _PERMANENT_TLS)
+
+
+PermanentTLSError = _PermanentTLSErrorType("PermanentTLSError", (Exception,), {})
+
+
+def _require(obj, attr, where):
+    if not hasattr(obj, attr):
+        raise ImproperlyConfigured("ozone_s3_creds: %s.%s is missing, this Hue version is not supported" % (where, attr))
+
+
+def _setting(module, *path):
+    try:
+        value = import_module(module)
+        for name in path:
+            value = getattr(value, name)
+    except (ImportError, AttributeError, KeyError):
+        return None
+    return value.get()
+
+
+def install():
+    cfg = conf.get()
+    try:
+        import boto.connection
+        import boto.exception
+        import boto.s3.connection
+        import boto.utils
+        from aws import client as aws_client
+        from aws import conf as aws_conf
+        from aws.s3 import s3fs
+        from boto.compat import http_client
+        from desktop.lib import fsmanager
+    except ImportError as e:
+        raise ImproperlyConfigured("ozone_s3_creds: required module is missing: %s" % e)
+    _require(fsmanager, "_get_client_cached", "desktop.lib.fsmanager")
+    _require(aws_client, "Client", "aws.client")
+    _require(aws_client.Client, "from_config", "aws.client.Client")
+    _require(s3fs, "S3FileSystem", "aws.s3.s3fs")
+    _require(boto.connection.AWSAuthConnection, "new_http_connection", "boto.connection.AWSAuthConnection")
+    _require(aws_conf, "AWS_ACCOUNTS", "aws.conf")
+    _check_hue_settings(cfg, aws_conf)
+    _patch_transport(boto.connection.AWSAuthConnection, http_client, boto.connection.HTTPResponse,
+                     boto.utils.parse_host, boto.exception.BotoClientError)
+    _patch_s3_connection(boto.s3.connection.S3Connection, boto.utils.parse_host, boto.exception.BotoClientError)
+    _patch_client_cache(fsmanager)
+    if cfg.bypass_hue_permission:
+        try:
+            from desktop.lib.fs.proxyfs import ProxyFS
+        except ImportError as e:
+            raise ImproperlyConfigured("ozone_s3_creds: required module is missing: %s" % e)
+        _require(ProxyFS, "_has_access", "desktop.lib.fs.proxyfs.ProxyFS")
+        _patch_proxyfs(ProxyFS)
+    try:
+        if not aws_conf.is_enabled():
+            log.warning("ozone_s3_creds: S3 is disabled in Hue; set a placeholder access_key_id "
+                        "in [aws] [[aws_accounts]] [[[default]]]")
+    except Exception as e:
+        log.warning("ozone_s3_creds: could not check whether S3 is enabled in Hue (%s)", type(e).__name__)
+
+
+def _check_hue_settings(cfg, aws_conf):
+    for name in aws_conf.AWS_ACCOUNTS.keys():
+        account = aws_conf.AWS_ACCOUNTS[name]
+        host = (account.HOST.get() or "").strip().lower()
+        if host != cfg.s3g_host or not account.IS_SECURE.get() or account.PROXY_ADDRESS.get():
+            raise ImproperlyConfigured(
+                "ozone_s3_creds: [aws] [[aws_accounts]] [[[%s]]] must set host=%s, is_secure=true and no proxy"
+                % (name, cfg.s3g_host))
+    for module, path, option in (("aws.conf", ("IS_SELF_SIGNING_ENABLED",), "[aws] is_self_signing_enabled"),
+                                 ("desktop.conf", ("RAZ", "IS_ENABLED"), "[desktop] [[raz]] is_enabled"),
+                                 ("filebrowser.conf", ("REDIRECT_DOWNLOAD",), "[filebrowser] redirect_download")):
+        if _setting(module, *path):
+            raise ImproperlyConfigured("ozone_s3_creds: %s bypasses mTLS to Ozone S3G and must be false" % option)
+
+
+def _patch_transport(connection_class, http_client, response_class, parse_host, refused):
+    original = connection_class.new_http_connection
+    if getattr(original, _MARK, False):
+        return
+
+    def new_http_connection(self, host, port, is_secure):
+        cfg = conf.get()
+        target = parse_host(host if host is not None else self.server_name()).lower()
+        owner = parse_host(self.host or "").lower()
+        if cfg.s3g_host not in (target, owner):
+            return original(self, host, port, is_secure)
+        if target != cfg.s3g_host or not is_secure or int(port or cfg.s3g_port) != cfg.s3g_port:
+            raise refused("refusing %s://%s:%s, Ozone S3G is reachable only over mTLS"
+                          % ("https" if is_secure else "http", target, port))
+        connection = http_client.HTTPSConnection(
+            cfg.s3g_host, port=cfg.s3g_port, timeout=self.http_connection_kwargs.get("timeout", cfg.request_timeout),
+            context=tls.boto_context())
+        connection.response_class = response_class
+        self._connection = (host, port, is_secure)
+        return connection
+
+    setattr(new_http_connection, _MARK, True)
+    connection_class.new_http_connection = new_http_connection
+
+
+def _patch_s3_connection(connection_class, parse_host, refused):
+    original = connection_class.__init__
+    if getattr(original, _MARK, False):
+        return
+
+    def __init__(self, *args, **kwargs):
+        cfg = conf.get()
+        ours = parse_host(kwargs.get("host") or "").lower() == cfg.s3g_host
+        if ours:
+            for key in _PROXY_KWARGS:
+                kwargs.pop(key, None)
+            kwargs["port"] = cfg.s3g_port
+        original(self, *args, **kwargs)
+        effective = parse_host(self.host or "").lower()
+        if ours or effective == cfg.s3g_host:
+            if not ours or effective != cfg.s3g_host or not self.is_secure or self.port != cfg.s3g_port \
+                    or getattr(self, "host_header", None):
+                raise refused("boto configuration overrides the Ozone S3G host, port or scheme; refusing")
+            self.use_proxy = False
+            self.auth_region_name = cfg.s3g_region
+            self.num_retries = min(self.num_retries, _MAX_RETRIES)
+            if PermanentTLSError not in self.http_unretryable_exceptions:
+                self.http_unretryable_exceptions.append(PermanentTLSError)
+
+    setattr(__init__, _MARK, True)
+    connection_class.__init__ = __init__
+
+
+def _patch_client_cache(fsmanager):
+    original = fsmanager._get_client_cached
+    if getattr(original, _MARK, False):
+        return
+    default_user = getattr(fsmanager, "_DEFAULT_USER", None)
+
+    def _get_client_cached(fs, name, user):
+        if fs != "s3a" or not user or user == default_user:
+            return original(fs, name, user)
+        from . import clients, service
+        return clients.get(name, user, service.credentials_for(user))
+
+    setattr(_get_client_cached, _MARK, True)
+    fsmanager._get_client_cached = _get_client_cached
+
+
+def _patch_proxyfs(proxyfs_class):
+    original = proxyfs_class._has_access
+    if getattr(original, _MARK, False):
+        return
+
+    def _has_access(self, fs):
+        try:
+            action = fs.filebrowser_action()
+        except Exception:
+            action = None
+        if action != _S3_PERMISSION:
+            return original(self, fs)
+        from . import service
+        try:
+            service.credentials_for(self.getuser())
+        except service.NoCredentials:
+            return False
+        return True
+
+    setattr(_has_access, _MARK, True)
+    proxyfs_class._has_access = _has_access
diff --git a/component-hue/docker/ozone_s3_creds/service.py b/component-hue/docker/ozone_s3_creds/service.py
new file mode 100644
index 0000000..2f5efd5
--- /dev/null
+++ b/component-hue/docker/ozone_s3_creds/service.py
@@ -0,0 +1,468 @@
+# -*- coding: utf-8 -*-
+from __future__ import absolute_import
+
+import hashlib
+import logging
+import os
+import struct
+import threading
+import time
+from contextlib import contextmanager
+from datetime import timedelta
+from importlib import import_module
+
+import boto.s3.connection
+import gssapi
+from django.conf import settings
+from django.contrib.auth import get_user_model
+from django.contrib.sessions.models import Session
+from django.core.exceptions import ImproperlyConfigured
+from django.db import connections
+from django.utils import timezone
+
+from . import broker, clients, conf, crypto, kerberos, middleware
+from .db import ALIAS
+from .models import S3BrokerNode, S3Credential, S3Session
+from .node import node_id
+
+log = logging.getLogger(__name__)
+
+_LOCK_USER = 0x0253
+_LOCK_LEADER = 0x0254
+_LOCK_WAIT = 60
+_CHUNK = 500
+_REVOKE_MIN_REMAINING = 30
+_NEW_SESSION_GRACE = 300
+_DB_SESSION_ENGINES = ("django.contrib.sessions.backends.db", "django.contrib.sessions.backends.cached_db")
+
+_thread_locks = {}
+_thread_locks_guard = threading.Lock()
+_admin_state = {"unsupported": False}
+
+
+class NoCredentials(IOError):
+    pass
+
+
+class LockTimeout(Exception):
+    pass
+
+
+class ForeignSecret(broker.BrokerError):
+    pass
+
+
+def check_environment():
+    engine = getattr(settings, "SESSION_ENGINE", "django.contrib.sessions.backends.db")
+    if engine not in _DB_SESSION_ENGINES:
+        raise ImproperlyConfigured("ozone_s3_creds requires database-backed sessions, got %s" % engine)
+    if "sqlite" in settings.DATABASES["default"].get("ENGINE", ""):
+        log.warning("ozone_s3_creds: SQLite is suitable for a single test instance only, use PostgreSQL or MySQL")
+
+
+def mask(access_key):
+    return (access_key[:4] + "***") if access_key else "-"
+
+
+def _chunks(items):
+    for i in range(0, len(items), _CHUNK):
+        yield items[i:i + _CHUNK]
+
+
+def _credentials():
+    return S3Credential.objects.using(ALIAS)
+
+
+def _sessions():
+    return S3Session.objects.using(ALIAS)
+
+
+def _lock_key(username):
+    return struct.unpack(">i", hashlib.sha256(username.encode("utf-8")).digest()[:4])[0]
+
+
+def _thread_lock(username):
+    with _thread_locks_guard:
+        lock = _thread_locks.get(username)
+        if lock is None:
+            lock = _thread_locks[username] = threading.RLock()
+        return lock
+
+
+def _db_try_lock(cursor, vendor, key):
+    if vendor == "postgresql":
+        cursor.execute("SELECT pg_try_advisory_lock(%s, %s)", key)
+    else:
+        cursor.execute("SELECT GET_LOCK(%s, 0)", ["ozone_s3_creds:%d:%d" % tuple(key)])
+    return bool(cursor.fetchone()[0])
+
+
+def _db_lock(key, wait):
+    connection = connections[ALIAS]
+    if connection.vendor not in ("postgresql", "mysql"):
+        return True
+    deadline = time.time() + wait
+    with connection.cursor() as cursor:
+        while True:
+            if _db_try_lock(cursor, connection.vendor, key):
+                return True
+            if time.time() >= deadline:
+                return False
+            time.sleep(0.2)
+
+
+def _db_unlock(key):
+    connection = connections[ALIAS]
+    if connection.vendor not in ("postgresql", "mysql"):
+        return
+    with connection.cursor() as cursor:
+        if connection.vendor == "postgresql":
+            cursor.execute("SELECT pg_advisory_unlock(%s, %s)", key)
+        else:
+            cursor.execute("SELECT RELEASE_LOCK(%s)", ["ozone_s3_creds:%d:%d" % tuple(key)])
+
+
+@contextmanager
+def user_lock(username, blocking=True):
+    thread_lock = _thread_lock(username)
+    if not thread_lock.acquire(blocking):
+        yield False
+        return
+    try:
+        key = [_LOCK_USER, _lock_key(username)]
+        if not _db_lock(key, _LOCK_WAIT if blocking else 0):
+            if blocking:
+                raise LockTimeout("could not lock broker state of user %s" % username)
+            yield False
+            return
+        try:
+            yield True
+        finally:
+            _db_unlock(key)
+    finally:
+        thread_lock.release()
+
+
+def admin_revoke_available():
+    return conf.get().admin_revoke and not _admin_state["unsupported"]
+
+
+def heartbeat(node=None):
+    S3BrokerNode.objects.using(ALIAS).update_or_create(node=node or node_id(), defaults={"last_seen": timezone.now()})
+
+
+def _node_alive(node, now):
+    threshold = now - timedelta(seconds=conf.get().sweep_interval * 3)
+    return S3BrokerNode.objects.using(ALIAS).filter(node=node, last_seen__gte=threshold).exists()
+
+
+def session_key(request):
+    session = getattr(request, "session", None)
+    if session is None:
+        return None
+    if not session.session_key:
+        session.save()
+    return session.session_key
+
+
+def _accepted_by_s3g(access, secret):
+    cfg = conf.get()
+    os.environ["S3_USE_SIGV4"] = "True"
+    try:
+        s3 = boto.s3.connection.S3Connection(
+            aws_access_key_id=access, aws_secret_access_key=secret, host=cfg.s3g_host,
+            calling_format=boto.s3.connection.OrdinaryCallingFormat())
+        s3.http_connection_kwargs["timeout"] = cfg.request_timeout
+        resp = s3.make_request("GET", override_num_retries=0)
+        body = resp.read(broker.MAX_BODY)
+    except Exception as e:
+        log.error("ozone_s3_creds: stored secret could not be validated (%s: %s), keeping it",
+                  type(e).__name__, str(e)[:300])
+        return True
+    if resp.status == 403:
+        text = body.decode("utf-8", "replace") if isinstance(body, bytes) else body
+        if "InvalidAccessKeyId" in text or "SignatureDoesNotMatch" in text:
+            return False
+        if "<Code>AccessDenied</Code>" in text and ("<Resource>%s</Resource>" % access) in text:
+            return False
+    elif resp.status == 400:
+        log.error("ozone_s3_creds: S3G rejected the validation request (HTTP 400), check region/endpoint settings")
+    return True
+
+
+def _reusable(credential):
+    if credential.revoke_pending or not credential.secret or not credential.access_key:
+        return False
+    try:
+        secret = crypto.decrypt(credential.secret, credential.username)
+    except (ValueError, TypeError):
+        log.warning("ozone_s3_creds: stored secret for user=%s cannot be decrypted, rotating", credential.username)
+        return False
+    if not _accepted_by_s3g(credential.access_key, secret):
+        log.warning("ozone_s3_creds: stored secret for user=%s is rejected by S3G, rotating", credential.username)
+        return False
+    return True
+
+
+def _issue(creds, own_secret):
+    try:
+        return broker.generate(creds)
+    except broker.SecretExists:
+        if not (own_secret or conf.get().rotate_foreign):
+            raise ForeignSecret(
+                "an S3 secret issued outside Hue already exists; revoke it or set OZONE_S3_ROTATE_FOREIGN=true")
+        broker.revoke(creds)
+        return broker.generate(creds)
+
+
+def provision(session_key, username, password):
+    if not session_key:
+        log.warning("ozone_s3_creds: no session for user=%s, provisioning skipped", username)
+        return False
+    try:
+        creds = kerberos.kinit(username, password)
+    except gssapi.exceptions.GSSError as e:
+        log.warning("ozone_s3_creds: kerberos authentication failed for user=%s (%s)", username, type(e).__name__)
+        return False
+    node = node_id()
+    try:
+        heartbeat(node)
+        with user_lock(username):
+            credential = _credentials().filter(username=username).first()
+            existed = credential is not None
+            reused = existed and _reusable(credential)
+            if reused:
+                credential.owner = node
+                credential.save(using=ALIAS, update_fields=["owner"])
+                kerberos.remember(username, creds)
+            else:
+                if credential is None:
+                    credential = S3Credential(username=username, created_at=timezone.now())
+                credential.owner = node
+                credential.secret = ""
+                credential.revoke_pending = True
+                credential.save(using=ALIAS)
+                kerberos.remember(username, creds)
+                try:
+                    access, secret = _issue(creds, own_secret=existed)
+                except ForeignSecret:
+                    credential.delete(using=ALIAS)
+                    kerberos.forget(username, creds)
+                    raise
+                credential.access_key = access
+                credential.secret = crypto.encrypt(secret, username)
+                credential.revoke_pending = False
+                credential.created_at = timezone.now()
+                credential.save(using=ALIAS)
+            _sessions().update_or_create(
+                session_key=session_key, defaults={"username": username, "created_at": timezone.now()})
+    except broker.BrokerError as e:
+        log.error("ozone_s3_creds: provisioning failed for user=%s: %s", username, e)
+        return False
+    except Exception:
+        log.exception("ozone_s3_creds: provisioning failed for user=%s", username)
+        try:
+            owned = _credentials().filter(username=username, owner=node).exists()
+        except Exception:
+            owned = False
+        if not owned:
+            kerberos.forget(username, creds)
+        return False
+    clients.forget_user(username)
+    log.info("ozone_s3_creds: secret %s for user=%s access=%s",
+             "reused" if reused else "issued", username, mask(credential.access_key))
+    return True
+
+
+def credentials_for(username):
+    session_key = middleware.current_session_key()
+    if not username or not session_key:
+        raise NoCredentials("Ozone S3 credentials are only available inside an authenticated request")
+    cache = middleware.memo()
+    cache_key = ("credentials", username, session_key)
+    if cache is not None and cache_key in cache:
+        return cache[cache_key]
+    denied = NoCredentials("Ozone S3 credentials are not available for user %s, log in again" % username)
+    if not _sessions().filter(session_key=session_key, username=username).exists():
+        raise denied
+    credential = _credentials().filter(username=username, revoke_pending=False).first()
+    if credential is None or not credential.secret:
+        raise denied
+    try:
+        result = (credential.access_key, crypto.decrypt(credential.secret, username))
+    except (ValueError, TypeError):
+        log.warning("ozone_s3_creds: stored secret for user=%s cannot be decrypted", username)
+        raise denied
+    if cache is not None:
+        cache[cache_key] = result
+    return result
+
+
+def _has_active_sessions(username):
+    model = get_user_model()
+    if not model.objects.using(ALIAS).filter(**{model.USERNAME_FIELD: username, "is_active": True}).exists():
+        return False
+    return _sessions().filter(username=username).exists()
+
+
+def _revoke_remote(credential, owned):
+    if admin_revoke_available():
+        kerberos_id = credential.access_key or kerberos.principal(credential.username)
+        try:
+            broker.revoke_as_admin(kerberos_id)
+            return True
+        except broker.AdminRevokeUnsupported:
+            _admin_state["unsupported"] = True
+            log.error("ozone_s3_creds: S3G does not support DELETE /secret/{kerberosID}, admin revocation disabled")
+        except (broker.BrokerError, gssapi.exceptions.GSSError) as e:
+            log.warning("ozone_s3_creds: admin revocation failed for user=%s: %s", credential.username, e)
+    if not owned:
+        return False
+    creds = kerberos.user_creds(credential.username, _REVOKE_MIN_REMAINING)
+    if creds is None:
+        return False
+    try:
+        broker.revoke(creds)
+        return True
+    except broker.BrokerError as e:
+        log.warning("ozone_s3_creds: revocation failed for user=%s: %s", credential.username, e)
+        return False
+
+
+def _revoke_locked(credential, node, reason, force=False):
+    username = credential.username
+    if not force and _has_active_sessions(username):
+        return False
+    owned = credential.owner == node
+    if _revoke_remote(credential, owned):
+        credential.delete(using=ALIAS)
+        kerberos.forget(username)
+        clients.forget_user(username)
+        log.info("ozone_s3_creds: secret revoked for user=%s access=%s (%s)", username, mask(credential.access_key), reason)
+        return True
+    clients.forget_user(username)
+    if not owned:
+        kerberos.forget(username)
+    if credential.revoke_pending and not credential.secret:
+        return False
+    log.error("ozone_s3_creds: secret for user=%s access=%s could not be revoked (%s); it stays valid in Ozone "
+              "until the user logs in to Hue again or it is revoked manually",
+              username, mask(credential.access_key), reason)
+    credential.secret = ""
+    credential.revoke_pending = True
+    credential.save(using=ALIAS, update_fields=["secret", "revoke_pending"])
+    return False
+
+
+def _end_sessions_locked(username, reason):
+    keys = list(_sessions().filter(username=username).values_list("session_key", flat=True))
+    store = import_module(settings.SESSION_ENGINE).SessionStore
+    for key in keys:
+        store(session_key=key).delete()
+    _sessions().filter(username=username).delete()
+    if keys:
+        log.warning("ozone_s3_creds: ended %d Hue session(s) of user=%s (%s)", len(keys), username, reason)
+
+
+def revoke_user(username, reason):
+    with user_lock(username):
+        credential = _credentials().filter(username=username).first()
+        if credential is None:
+            kerberos.forget(username)
+            clients.forget_user(username)
+            return True
+        return _revoke_locked(credential, node_id(), reason)
+
+
+def logout(session_key, username):
+    node = node_id()
+    with user_lock(username):
+        if session_key:
+            _sessions().filter(session_key=session_key).delete()
+        credential = _credentials().filter(username=username).first()
+        if credential is None:
+            kerberos.forget(username)
+            clients.forget_user(username)
+            return
+        if _has_active_sessions(username):
+            return
+        if admin_revoke_available() or credential.owner == node:
+            _revoke_locked(credential, node, "logout")
+
+
+def _purge_ended_sessions(now):
+    grace = now - timedelta(seconds=_NEW_SESSION_GRACE)
+    rows = list(_sessions().values_list("session_key", "created_at"))
+    ended = []
+    for chunk in _chunks(rows):
+        keys = [key for key, _ in chunk]
+        present = dict(Session.objects.using(ALIAS).filter(session_key__in=keys).values_list("session_key", "expire_date"))
+        for key, created_at in chunk:
+            if key in present:
+                if present[key] <= now:
+                    ended.append(key)
+            elif created_at < grace:
+                ended.append(key)
+    for chunk in _chunks(ended):
+        _sessions().filter(session_key__in=chunk).delete()
+
+
+def _sweep_user(username, node, now):
+    cfg = conf.get()
+    with user_lock(username, blocking=False) as locked:
+        if not locked:
+            return
+        credential = _credentials().filter(username=username).first()
+        if credential is None:
+            kerberos.forget(username)
+            return
+        mine = credential.owner == node
+        if not mine:
+            kerberos.forget(username)
+        admin = admin_revoke_available()
+        if not admin and not mine and _node_alive(credential.owner, now):
+            return
+        if credential.revoke_pending:
+            _revoke_locked(credential, node, "issuing was interrupted", force=True)
+        elif not _has_active_sessions(username):
+            if _sessions().filter(username=username).exists():
+                _end_sessions_locked(username, "user is disabled or deleted")
+            _revoke_locked(credential, node, "no active Hue sessions")
+        elif not admin and (not mine or kerberos.user_creds(username, cfg.ticket_min_remaining) is None):
+            _end_sessions_locked(username, "kerberos ticket required for revocation is expiring or unavailable")
+            _revoke_locked(credential, node, "Hue sessions ended before the kerberos ticket expired")
+        elif cfg.secret_max_age and (now - credential.created_at).total_seconds() > cfg.secret_max_age:
+            _end_sessions_locked(username, "secret max age exceeded")
+            _revoke_locked(credential, node, "secret max age exceeded")
+
+
+def _forget_orphaned_creds(node):
+    for username in kerberos.known_users():
+        with user_lock(username, blocking=False) as locked:
+            if locked and not _credentials().filter(username=username, owner=node).exists():
+                kerberos.forget(username)
+
+
+def sweep(node=None):
+    cfg = conf.get()
+    node = node or node_id()
+    now = timezone.now()
+    heartbeat(node)
+    leader_key = [_LOCK_LEADER, 0]
+    if _db_lock(leader_key, 0):
+        try:
+            _purge_ended_sessions(now)
+            S3BrokerNode.objects.using(ALIAS).filter(
+                last_seen__lt=now - timedelta(seconds=cfg.sweep_interval * 10)).delete()
+        finally:
+            _db_unlock(leader_key)
+    last_beat = time.time()
+    for username in list(_credentials().values_list("username", flat=True)):
+        if time.time() - last_beat > cfg.sweep_interval / 2.0:
+            heartbeat(node)
+            last_beat = time.time()
+        try:
+            _sweep_user(username, node, timezone.now())
+        except Exception:
+            log.exception("ozone_s3_creds: sweep failed for user=%s", username)
+    _forget_orphaned_creds(node)
