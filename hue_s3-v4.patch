@@ -0,0 +1,66 @@
+# -*- coding: utf-8 -*-
+from __future__ import absolute_import
+
+import logging
+import os
+import threading
+import time
+
+from django.db import connections
+
+from . import conf
+
+log = logging.getLogger(__name__)
+
+_ERROR_LOG_INTERVAL = 600
+
+_state = {"pid": None}
+_guard = threading.Lock()
+
+
+def _disabled():
+    return os.environ.get("OZONE_S3_SWEEPER", "").strip().lower() in ("0", "false", "no", "off")
+
+
+def ensure_started():
+    pid = os.getpid()
+    if _state["pid"] == pid:
+        return
+    with _guard:
+        if _state["pid"] == pid:
+            return
+        _state["pid"] = pid
+        if _disabled():
+            return
+        thread = threading.Thread(target=_loop, args=(pid,), name="ozone-s3-creds-sweeper")
+        thread.daemon = True
+        thread.start()
+
+
+def _close_connections():
+    for connection in connections.all():
+        connection.close()
+
+
+def _loop(pid):
+    from . import service
+    interval = conf.get().sweep_interval
+    last_error = {"type": None, "at": 0.0}
+    try:
+        service.heartbeat()
+    except Exception:
+        log.warning("ozone_s3_creds: initial heartbeat failed", exc_info=True)
+    finally:
+        _close_connections()
+    while os.getpid() == pid:
+        time.sleep(interval)
+        try:
+            service.sweep()
+            last_error["type"] = None
+        except Exception as e:
+            now = time.time()
+            if type(e) is not last_error["type"] or now - last_error["at"] > _ERROR_LOG_INTERVAL:
+                log.exception("ozone_s3_creds: sweep failed")
+                last_error["type"], last_error["at"] = type(e), now
+        finally:
+            _close_connections()
