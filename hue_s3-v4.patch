@@ -0,0 +1,34 @@
+# -*- coding: utf-8 -*-
+from __future__ import absolute_import
+
+import logging
+
+from django.apps import AppConfig
+
+_SENSITIVE_LOGGERS = ("requests_gssapi", "requests_gssapi.gssapi_", "boto")
+
+
+class _DropAuthorization(logging.Filter):
+
+    def filter(self, record):
+        try:
+            message = record.getMessage()
+        except Exception:
+            return False
+        return "Negotiate " not in message and "authorization" not in message.lower()
+
+
+class OzoneS3CredsConfig(AppConfig):
+    name = "ozone_s3_creds"
+    verbose_name = "Ozone S3 per-user credentials"
+
+    def ready(self):
+        for name in _SENSITIVE_LOGGERS:
+            logging.getLogger(name).addFilter(_DropAuthorization())
+        logging.getLogger("requests_gssapi").setLevel(logging.WARNING)
+        from . import conf, db, patch, service, signals, tls  # noqa: F401
+        conf.get()
+        tls.check()
+        db.register()
+        service.check_environment()
+        patch.install()
diff --git a/component-hue/docker/ozone_s3_creds/broker.py b/component-hue/docker/ozone_s3_creds/broker.py
new file mode 100644
index 0000000..f87d2b7
--- /dev/null
+++ b/component-hue/docker/ozone_s3_creds/broker.py
@@ -0,0 +1,160 @@
+# -*- coding: utf-8 -*-
+from __future__ import absolute_import
+
+import xml.etree.ElementTree as ET
+
+import gssapi
+import requests
+from requests.adapters import HTTPAdapter
+from requests_gssapi import DISABLED, REQUIRED, HTTPSPNEGOAuth
+from requests_gssapi.gssapi_ import SanitizedResponse
+
+from . import conf, kerberos, tls
+
+try:
+    from urllib.parse import quote
+except ImportError:
+    from urllib import quote
+
+MAX_BODY = 64 * 1024
+
+
+class BrokerError(Exception):
+    pass
+
+
+class SecretExists(BrokerError):
+    pass
+
+
+class AdminRevokeUnsupported(BrokerError):
+    pass
+
+
+class TransportRefused(requests.exceptions.InvalidURL):
+    pass
+
+
+class Response(object):
+
+    def __init__(self, status, content_type, body, authenticated):
+        self.status = status
+        self.content_type = content_type
+        self.body = body
+        self.authenticated = authenticated
+
+    def describe(self):
+        return "HTTP %d, content-type=%s, %d bytes, mutual-auth=%s" % (
+            self.status, self.content_type, len(self.body),
+            {True: "ok", False: "missing", None: "off"}[self.authenticated])
+
+
+class _MTLSAdapter(HTTPAdapter):
+
+    def __init__(self, context):
+        self._context = context
+        super(_MTLSAdapter, self).__init__(max_retries=0)
+
+    def init_poolmanager(self, *args, **kwargs):
+        kwargs["ssl_context"] = self._context
+        return super(_MTLSAdapter, self).init_poolmanager(*args, **kwargs)
+
+    def proxy_manager_for(self, *args, **kwargs):
+        raise TransportRefused("proxies are not allowed for Ozone S3G")
+
+    def cert_verify(self, conn, url, verify, cert):
+        cfg = conf.get()
+        if not url.startswith(cfg.endpoint + "/") or verify != cfg.ca_file or cert is not None:
+            raise TransportRefused("Ozone S3G is reachable only over mTLS with the configured CA")
+        super(_MTLSAdapter, self).cert_verify(conn, url, verify, None)
+
+
+def _reason(error):
+    if isinstance(error, (requests.exceptions.SSLError, requests.exceptions.ConnectionError, TransportRefused,
+                          tls.TLSError)) or type(error).__name__ == "MutualAuthenticationError":
+        return "%s: %s" % (type(error).__name__, str(error)[:300])
+    return type(error).__name__
+
+
+def _request(method, path, creds):
+    cfg = conf.get()
+    target = gssapi.Name("HTTP/%s@%s" % (cfg.spn_host, cfg.realm), gssapi.NameType.kerberos_principal)
+    auth = HTTPSPNEGOAuth(creds=creds, target_name=target, opportunistic_auth=True,
+                          mutual_authentication=REQUIRED if cfg.mutual_auth else DISABLED)
+    session = None
+    try:
+        session = requests.Session()
+        session.trust_env = False
+        for adapter in session.adapters.values():
+            adapter.close()
+        session.adapters.clear()
+        session.mount(cfg.endpoint + "/", _MTLSAdapter(tls.requests_context()))
+        resp = session.request(method, cfg.endpoint + path, auth=auth, timeout=cfg.request_timeout,
+                               verify=cfg.ca_file, cert=None, proxies={}, allow_redirects=False, stream=True)
+        try:
+            chunks, size = [], 0
+            for chunk in resp.iter_content(8192):
+                chunks.append(chunk)
+                size += len(chunk)
+                if size > MAX_BODY:
+                    break
+            body = b"".join(chunks)
+        finally:
+            resp.close()
+    except (requests.RequestException, gssapi.exceptions.GSSError, tls.TLSError, IOError, ValueError) as e:
+        raise BrokerError("%s %s failed: %s" % (method, path, _reason(e)))
+    finally:
+        if session is not None:
+            session.close()
+    if len(body) > MAX_BODY:
+        raise BrokerError("%s %s: response body is too large" % (method, path))
+    authenticated = not isinstance(resp, SanitizedResponse) if cfg.mutual_auth else None
+    return Response(resp.status_code, resp.headers.get("Content-Type", "-"), body, authenticated)
+
+
+def _parse_secret(resp):
+    if b"<!DOCTYPE" in resp.body or b"<!ENTITY" in resp.body:
+        raise BrokerError("unexpected S3G response: %s" % resp.describe())
+    try:
+        root = ET.fromstring(resp.body)
+    except ET.ParseError:
+        raise BrokerError("unexpected S3G response: %s" % resp.describe())
+    access = secret = None
+    for elem in root.iter():
+        tag = elem.tag.rsplit("}", 1)[-1]
+        if tag == "awsAccessKey" and elem.text:
+            access = elem.text.strip()
+        elif tag == "awsSecret" and elem.text:
+            secret = elem.text.strip()
+    if not access or not secret:
+        raise BrokerError("S3G response has no credentials: %s" % resp.describe())
+    return access, secret
+
+
+def _trusted(resp):
+    return resp.authenticated is not False
+
+
+def generate(creds):
+    resp = _request("PUT", "/secret", creds)
+    if resp.status == 400 and _trusted(resp):
+        raise SecretExists("secret already exists: %s" % resp.describe())
+    if resp.status != 200:
+        raise BrokerError("PUT /secret: %s" % resp.describe())
+    return _parse_secret(resp)
+
+
+def revoke(creds):
+    resp = _request("DELETE", "/secret", creds)
+    if resp.status == 200 or (resp.status == 404 and _trusted(resp)):
+        return
+    raise BrokerError("DELETE /secret: %s" % resp.describe())
+
+
+def revoke_as_admin(kerberos_id):
+    resp = _request("DELETE", "/secret/%s" % quote(kerberos_id, safe=""), kerberos.admin_creds())
+    if resp.status == 405 and _trusted(resp):
+        raise AdminRevokeUnsupported("S3G does not support DELETE /secret/{kerberosID}")
+    if resp.status == 200 or (resp.status == 404 and _trusted(resp)):
+        return
+    raise BrokerError("DELETE /secret/{kerberosID}: %s" % resp.describe())
diff --git a/component-hue/docker/ozone_s3_creds/clients.py b/component-hue/docker/ozone_s3_creds/clients.py
new file mode 100644
index 0000000..13685f1
--- /dev/null
+++ b/component-hue/docker/ozone_s3_creds/clients.py
@@ -0,0 +1,67 @@
+# -*- coding: utf-8 -*-
+from __future__ import absolute_import
+
+import hashlib
+import threading
+import time
+
+from . import conf
+
+_lock = threading.Lock()
+_cache = {}
+
+
+class _StaticCredentials(object):
+
+    def __init__(self, access, secret, expiration):
+        self._access = access
+        self._secret = secret
+        self._expiration = expiration
+
+    def validate(self):
+        pass
+
+    def get_credentials(self):
+        return {
+            "AccessKeyId": self._access,
+            "SecretAccessKey": self._secret,
+            "SessionToken": None,
+            "AllowEnvironmentCredentials": False,
+            "Expiration": self._expiration,
+        }
+
+
+def _now_ms():
+    return int(time.time() * 1000)
+
+
+def _fingerprint(access, secret):
+    return hashlib.sha256(("%s:%s" % (access, secret)).encode("utf-8")).hexdigest()
+
+
+def get(name, username, credentials):
+    access, secret = credentials
+    fingerprint = _fingerprint(access, secret)
+    key = (name, username)
+    with _lock:
+        cached = _cache.get(key)
+        if cached and cached[0] == fingerprint and cached[1].expiration and cached[1].expiration > _now_ms():
+            return cached[1]
+
+    from aws import client as aws_client
+    from aws import conf as aws_conf
+    from aws.s3.s3fs import S3FileSystem
+
+    client_conf = aws_conf.AWS_ACCOUNTS[name] if name in aws_conf.AWS_ACCOUNTS else None
+    provider = _StaticCredentials(access, secret, _now_ms() + conf.get().client_ttl * 1000)
+    builder = aws_client.Client.from_config(client_conf, provider)
+    filesystem = S3FileSystem(builder.get_s3_connection(), builder.expiration)
+    with _lock:
+        _cache[key] = (fingerprint, filesystem)
+    return filesystem
+
+
+def forget_user(username):
+    with _lock:
+        for key in [k for k in _cache if k[1] == username]:
+            del _cache[key]
diff --git a/component-hue/docker/ozone_s3_creds/conf.py b/component-hue/docker/ozone_s3_creds/conf.py
new file mode 100644
index 0000000..6c727d4
--- /dev/null
+++ b/component-hue/docker/ozone_s3_creds/conf.py
@@ -0,0 +1,105 @@
+# -*- coding: utf-8 -*-
+from __future__ import absolute_import
+
+import os
+import re
+
+from django.core.exceptions import ImproperlyConfigured
+
+try:
+    from urllib.parse import urlparse
+except ImportError:
+    from urlparse import urlparse
+
+
+def _bool(name, default):
+    raw = os.environ.get(name, "").strip().lower()
+    if not raw:
+        return default
+    if raw in ("1", "true", "yes", "on"):
+        return True
+    if raw in ("0", "false", "no", "off"):
+        return False
+    raise ImproperlyConfigured("%s must be a boolean, got %r" % (name, raw))
+
+
+def _int(name, default, minimum):
+    raw = os.environ.get(name, "").strip()
+    if not raw:
+        return default
+    try:
+        value = int(raw)
+    except ValueError:
+        raise ImproperlyConfigured("%s must be an integer, got %r" % (name, raw))
+    if value < minimum:
+        raise ImproperlyConfigured("%s must be >= %d, got %d" % (name, minimum, value))
+    return value
+
+
+def _required(name):
+    value = os.environ.get(name, "").strip()
+    if not value:
+        raise ImproperlyConfigured("%s is required by ozone_s3_creds" % name)
+    return value
+
+
+_HOSTNAME = re.compile(r"^(?=.{1,253}$)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$")
+
+
+def _endpoint():
+    endpoint = _required("OZONE_S3G_ENDPOINT").rstrip("/")
+    parsed = urlparse(endpoint)
+    host, sep, port = parsed.netloc.lower().partition(":")
+    if parsed.scheme != "https" or parsed.path or parsed.params or parsed.query or parsed.fragment \
+            or not _HOSTNAME.match(host) or host.replace(".", "").isdigit() or (sep and port != "443"):
+        raise ImproperlyConfigured("OZONE_S3G_ENDPOINT must be https://<host name>[:443], got %r" % endpoint)
+    return "https://" + host, host
+
+
+class Settings(object):
+
+    def __init__(self):
+        if "OZONE_S3G_ALLOW_PLAINTEXT" in os.environ:
+            raise ImproperlyConfigured("OZONE_S3G_ALLOW_PLAINTEXT is not supported, Ozone S3G is reachable only over mTLS")
+        self.endpoint, self.s3g_host = _endpoint()
+        self.s3g_port = 443
+        self.s3g_region = os.environ.get("OZONE_S3G_REGION", "").strip() or "us-east-1"
+        self.realm = _required("KERBEROS_REALM")
+        self.spn_host = os.environ.get("OZONE_S3G_SPN_HOST", "").strip().lower() or self.s3g_host
+        self.ca_file = _required("OZONE_S3G_CA_FILE")
+        self.client_cert = _required("OZONE_S3G_CLIENT_CERT")
+        self.client_key = _required("OZONE_S3G_CLIENT_KEY")
+        mutual = os.environ.get("OZONE_S3G_MUTUAL_AUTH", "").strip().lower() or "required"
+        if mutual not in ("required", "disabled"):
+            raise ImproperlyConfigured("OZONE_S3G_MUTUAL_AUTH must be required or disabled, got %r" % mutual)
+        self.mutual_auth = mutual == "required"
+        self.admin_principal = os.environ.get("OZONE_S3_ADMIN_PRINCIPAL", "").strip() or None
+        self.admin_keytab = os.environ.get("OZONE_S3_ADMIN_KEYTAB", "").strip() or None
+        if bool(self.admin_principal) != bool(self.admin_keytab):
+            raise ImproperlyConfigured("OZONE_S3_ADMIN_PRINCIPAL and OZONE_S3_ADMIN_KEYTAB must be set together")
+        self.request_timeout = _int("OZONE_S3G_TIMEOUT", 15, 1)
+        self.sweep_interval = _int("OZONE_S3_SWEEP_INTERVAL", 60, 5)
+        self.ticket_min_remaining = _int("OZONE_S3_TICKET_MIN_REMAINING", 900, 60)
+        self.client_ttl = _int("OZONE_S3_CLIENT_TTL", 300, 10)
+        self.secret_max_age = _int("OZONE_S3_SECRET_MAX_AGE", 0, 0)
+        self.rotate_foreign = _bool("OZONE_S3_ROTATE_FOREIGN", True)
+        self.bypass_hue_permission = _bool("OZONE_S3_BYPASS_HUE_PERMISSION", False)
+
+    @property
+    def admin_revoke(self):
+        return self.admin_principal is not None
+
+
+_settings = None
+
+
+def get():
+    global _settings
+    if _settings is None:
+        _settings = Settings()
+    return _settings
+
+
+def reset():
+    global _settings
+    _settings = None
