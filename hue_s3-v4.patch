@@ -0,0 +1,47 @@
+# -*- coding: utf-8 -*-
+from __future__ import absolute_import
+
+import base64
+import hashlib
+import hmac
+import os
+
+from Cryptodome.Cipher import AES
+from django.conf import settings
+from django.core.exceptions import ImproperlyConfigured
+
+_PREFIX = b"v1:"
+_NONCE = 12
+_TAG = 16
+
+
+def _bytes(value):
+    return value if isinstance(value, bytes) else value.encode("utf-8")
+
+
+def _key():
+    secret = getattr(settings, "SECRET_KEY", None)
+    if not secret:
+        raise ImproperlyConfigured("ozone_s3_creds needs a non-empty SECRET_KEY")
+    return hmac.new(_bytes(secret), b"ozone_s3_creds/aes-256-gcm/v1", hashlib.sha256).digest()
+
+
+def encrypt(plaintext, context):
+    nonce = os.urandom(_NONCE)
+    cipher = AES.new(_key(), AES.MODE_GCM, nonce=nonce)
+    cipher.update(_bytes(context))
+    ciphertext, tag = cipher.encrypt_and_digest(_bytes(plaintext))
+    return (_PREFIX + base64.b64encode(nonce + tag + ciphertext)).decode("ascii")
+
+
+def decrypt(token, context):
+    raw = _bytes(token)
+    if not raw.startswith(_PREFIX):
+        raise ValueError("unsupported token format")
+    data = base64.b64decode(raw[len(_PREFIX):])
+    if len(data) <= _NONCE + _TAG:
+        raise ValueError("token is too short")
+    nonce, tag, ciphertext = data[:_NONCE], data[_NONCE:_NONCE + _TAG], data[_NONCE + _TAG:]
+    cipher = AES.new(_key(), AES.MODE_GCM, nonce=nonce)
+    cipher.update(_bytes(context))
+    return cipher.decrypt_and_verify(ciphertext, tag).decode("utf-8")
