+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * AccessAPI client, an alternative to reading FreeIPA directly over LDAP.
+ *
+ * Uses a single endpoint, {@code GET /idm/find?login=<LOGIN>}, and reads the
+ * {@code memberof} field. The bulk endpoint {@code /idm/groups} returns groups
+ * with their members and is inverted into the uid -> groups map.
+ *
+ * Authentication is selected by {@link IpaConfig#API_AUTH}.
+ */
+public class IpaAccessApiClient implements IpaUserGroupSource {
+    private static final Logger LOG = LoggerFactory.getLogger(IpaAccessApiClient.class);
+
+    /** Field names in the bulk /idm/groups response. */
+    private static final String GROUP_NAME_FIELD    = "cn";
+    private static final String GROUP_MEMBERS_FIELD = "members";
+
+    private final IpaConfig cfg;
+    private final AtomicReference<SSLSocketFactory> trustFactory = new AtomicReference<>();
+    private final AtomicReference<UserGroupInformation> apiUgi   = new AtomicReference<>();
+
+    public IpaAccessApiClient(IpaConfig cfg) {
+        this.cfg = cfg;
+    }
+
+    @Override
+    public boolean supportsFullSync() {
+        return true;
+    }
+
+    @Override
+    public Map<String, Set<String>> fetchUserGroups() throws IOException {
+        String body = get(cfg.getApiUrl() + cfg.getApiGroupsPath());
+        Map<String, Set<String>> byUser = new HashMap<String, Set<String>>();
+        if (body == null || body.isEmpty()) {
+            return byUser;
+        }
+        int groups = 0;
+        for (String obj : JsonLite.objectsWithKey(body, GROUP_NAME_FIELD)) {
+            String cn = JsonLite.extractString(obj, GROUP_NAME_FIELD);
+            if (cn == null || cn.isEmpty() || cfg.getGroupExclude().contains(cn)) {
+                continue;
+            }
+            groups++;
+            for (String member : JsonLite.extractStringArray(obj, GROUP_MEMBERS_FIELD)) {
+                Set<String> s = byUser.get(member);
+                if (s == null) {
+                    s = new HashSet<String>();
+                    byUser.put(member, s);
+                }
+                s.add(cn);
+            }
+        }
+        LOG.info("AccessAPI full sync: {} groups, {} users", groups, byUser.size());
+        return byUser;
+    }
+
+    @Override
+    public Set<String> fetchGroupsForUser(String user) throws IOException {
+        String url = cfg.getApiUrl() + "/idm/find?login="
+                + URLEncoder.encode(user, StandardCharsets.UTF_8.name());
+
+        String body = get(url);
+        if (body == null || body.isEmpty()) {
+            return Collections.emptySet();
+        }
+
+        Set<String> groups = new LinkedHashSet<>();
+        for (String g : JsonLite.extractStringArray(body, "memberof")) {
+            if (!cfg.getGroupExclude().contains(g)) {
+                groups.add(g);
+            }
+        }
+        return groups;
+    }
+
+    private String get(String url) throws IOException {
+        HttpURLConnection conn = cfg.isApiAuthGateway() ? openPlain(url) : openSpnego(url);
+        conn.setRequestMethod("GET");
+        conn.setConnectTimeout(cfg.getConnectTimeoutMs());
+        conn.setReadTimeout(cfg.getReadTimeoutMs());
+        conn.setRequestProperty("Accept", "application/json");
+
+        try {
+            int code = conn.getResponseCode();
+            if (code == HttpURLConnection.HTTP_NOT_FOUND) {
+                // Not in the directory — a valid answer, not an error.
+                return null;
+            }
+            if (code != HttpURLConnection.HTTP_OK) {
+                throw new IOException("AccessAPI returned HTTP " + code + " for " + stripQuery(url)
+                        + (code == HttpURLConnection.HTTP_UNAUTHORIZED
+                        || code == HttpURLConnection.HTTP_FORBIDDEN
+                        ? " (check that the service account is in the API access group)" : ""));
+            }
+            try (InputStream in = conn.getInputStream()) {
+                return readAll(in);
+            }
+        } finally {
+            conn.disconnect();
+        }
+    }
+
+        /**
+     * SPNEGO. A fresh token per request on purpose: AuthenticatedURL.Token is
+     * mutable and not thread-safe.
+     *
+     * When {@link IpaConfig#API_CA_CERT} is set, TLS is verified against it instead
+     * of the JVM truststore — the corporate CA is usually missing from the image's
+     * cacerts, which would fail with SSLException before SPNEGO even starts.
+     */
+    private HttpURLConnection openSpnego(String url) throws IOException {
+        final SSLSocketFactory factory = trustOnlySocketFactory();
+        final ConnectionConfigurator configurator = conn -> {
+            if (factory != null && conn instanceof HttpsURLConnection) {
+                ((HttpsURLConnection) conn).setSSLSocketFactory(factory);
+            }
+            return conn;
+        };
+        try {
+            return apiUgi().doAs(
+                    (java.security.PrivilegedExceptionAction<HttpURLConnection>) () -> {
+                        AuthenticatedURL.Token token = new AuthenticatedURL.Token();
+                        return new AuthenticatedURL(new KerberosAuthenticator(), configurator)
+                                .openConnection(new URL(url), token);
+                    });
+        } catch (IOException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IOException("SPNEGO request failed for " + stripQuery(url), e);
+        }
+    }
+
+        /**
+     * Request without client credentials on the application side.
+     *
+     * In {@value IpaConfig#API_AUTH_GATEWAY} mode the egress gateway terminates the
+     * traffic and presents AccessAPI a client certificate whose CN is registered
+     * there. The application sends plain HTTP inside the mesh, where the hop to the
+     * gateway is protected by the mesh's own mTLS. Kerberos is not involved, which
+     * avoids having to reach a service in a foreign realm.
+     */
+    private HttpURLConnection openPlain(String url) throws IOException {
+        return (HttpURLConnection) new URL(url).openConnection();
+    }
+
+        /**
+     * UGI the AccessAPI request runs as; the daemon principal by default.
+     *
+     * AccessAPI lives in the corporate realm and grants access to a corporate
+     * account, which a principal like om/om@<cluster realm> does not belong to —
+     * without cross-realm trust it cannot even obtain a service ticket. Setting
+     * {@link IpaConfig#API_PRINCIPAL} and {@link IpaConfig#API_KEYTAB} logs in as a
+     * dedicated account instead.
+     */
+    private UserGroupInformation apiUgi() throws IOException {
+        String principal = cfg.getApiPrincipal();
+        String keytab    = cfg.getApiKeytab();
+        if (principal == null || principal.isEmpty() || keytab == null || keytab.isEmpty()) {
+            return UserGroupInformation.getLoginUser();
+        }
+        UserGroupInformation ugi = apiUgi.get();
+        if (ugi == null) {
+            synchronized (apiUgi) {
+                ugi = apiUgi.get();
+                if (ugi == null) {
+                    ugi = UserGroupInformation
+                            .loginUserFromKeytabAndReturnUGI(principal, keytab);
+                    apiUgi.set(ugi);
+                    LOG.info("AccessAPI: authenticating as {} (keytab {})", principal, keytab);
+                }
+            }
+        }
+                // This UGI has no background renewer, so the ticket is refreshed here;
+        // otherwise everything stops once the ticket lifetime expires.
+        ugi.checkTGTAndReloginFromKeytab();
+        return ugi;
+    }
+
+    /** Truststore from {@link IpaConfig#API_CA_CERT}; null means the JVM default. */
+    private SSLSocketFactory trustOnlySocketFactory() throws IOException {
+        String ca = cfg.getApiCaCert();
+        if (ca == null || ca.isEmpty()) {
+            return null;
+        }
+        SSLSocketFactory cached = trustFactory.get();
+        if (cached != null) return cached;
+        try {
+            SSLContext ctx = SSLContext.getInstance("TLS");
+            ctx.init(null, buildTrustManagers(ca), null);
+            SSLSocketFactory f = ctx.getSocketFactory();
+            trustFactory.set(f);
+            return f;
+        } catch (IOException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IOException("failed to build trust store from " + ca, e);
+        }
+    }
+
+    private TrustManager[] buildTrustManagers(String caPath) throws Exception {
+        KeyStore ts = KeyStore.getInstance(KeyStore.getDefaultType());
+        ts.load(null, null);
+        int i = 0;
+        for (Certificate c : readCertificates(caPath)) {
+            ts.setCertificateEntry("accessapi-ca-" + (i++), c);
+        }
+        TrustManagerFactory tmf =
+                TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm());
+        tmf.init(ts);
+        return tmf.getTrustManagers();
+    }
+
+    private static Collection<? extends Certificate> readCertificates(String path)
+            throws IOException {
+        try (InputStream in = Files.newInputStream(Paths.get(path))) {
+            CertificateFactory cf = CertificateFactory.getInstance("X.509");
+            return cf.generateCertificates(in);
+        } catch (java.security.cert.CertificateException e) {
+            throw new IOException("failed to read certificates from " + path, e);
+        }
+    }
+
+    private static String readAll(InputStream in) throws IOException {
+        StringBuilder sb = new StringBuilder();
+        try (Reader r = new InputStreamReader(in, StandardCharsets.UTF_8)) {
+            char[] buf = new char[4096];
+            int n;
+            while ((n = r.read(buf)) > 0) {
+                sb.append(buf, 0, n);
+            }
+        }
+        return sb.toString();
+    }
+
+    /** The login must never reach logs or error messages. */
+    private static String stripQuery(String url) {
+        int q = url.indexOf('?');
+        return q < 0 ? url : url.substring(0, q);
+    }
+
+        /**
+     * Minimal JSON reader for a single job: pull a string array out by field name.
+     *
+     * A full parser (Jackson) is deliberately avoided: the module is loaded through
+     * ranger-plugin-classloader, where an extra dependency risks clashing with the
+     * runtime version. Exactly one value type is needed — an array of strings.
+     */
+    static final class JsonLite {
+        private JsonLite() {}
+
+        static List<String> extractStringArray(String json, String field) {
+            List<String> out = new ArrayList<>();
+            String needle = "\"" + field + "\"";
+            int from = 0;
+            while (true) {
+                int k = json.indexOf(needle, from);
+                if (k < 0) break;
+                int colon = json.indexOf(':', k + needle.length());
+                if (colon < 0) break;
+
+                int p = skipWs(json, colon + 1);
+                if (p >= json.length() || json.charAt(p) != '[') {
+                    from = k + needle.length();
+                    continue;
+                }
+                p++; // '['
+                while (p < json.length()) {
+                    p = skipWs(json, p);
+                    if (p >= json.length() || json.charAt(p) == ']') break;
+                    if (json.charAt(p) == ',') { p++; continue; }
+                    if (json.charAt(p) != '"') break;
+                    StringBuilder sb = new StringBuilder();
+                    p++; // opening quote
+                    while (p < json.length() && json.charAt(p) != '"') {
+                        char c = json.charAt(p);
+                        if (c == '\\' && p + 1 < json.length()) {
+                            p++;
+                            sb.append(unescape(json.charAt(p)));
+                        } else {
+                            sb.append(c);
+                        }
+                        p++;
+                    }
+                    p++; // closing quote
+                    String v = sb.toString().trim();
+                    if (!v.isEmpty()) out.add(v);
+                }
+                from = p;
+            }
+            return out;
+        }
+
+        /** Objects at any depth that carry {@code key} at their own top level. */
+        static List<String> objectsWithKey(String json, String key) {
+            List<String> out = new ArrayList<String>();
+            Deque<Integer> starts = new ArrayDeque<Integer>();
+            boolean inStr = false;
+            for (int i = 0; i < json.length(); i++) {
+                char c = json.charAt(i);
+                if (inStr) {
+                    if (c == '\\') i++;
+                    else if (c == '"') inStr = false;
+                    continue;
+                }
+                if (c == '"') { inStr = true; continue; }
+                if (c == '{') { starts.push(i); continue; }
+                if (c == '}' && !starts.isEmpty()) {
+                    String span = json.substring(starts.pop(), i + 1);
+                    if (topLevelKeyPos(span, key) >= 0) out.add(span);
+                }
+            }
+            return out;
+        }
+
+        /** First string value of {@code field} at the object's top level; null if absent. */
+        static String extractString(String json, String field) {
+            int p = topLevelKeyPos(json, field);
+            if (p < 0) return null;
+            int colon = json.indexOf(':', p);
+            if (colon < 0) return null;
+            int q = skipWs(json, colon + 1);
+            if (q >= json.length() || json.charAt(q) != '"') return null;
+            StringBuilder sb = new StringBuilder();
+            q++;
+            while (q < json.length() && json.charAt(q) != '"') {
+                char c = json.charAt(q);
+                if (c == '\\' && q + 1 < json.length()) {
+                    q++;
+                    sb.append(unescape(json.charAt(q)));
+                } else {
+                    sb.append(c);
+                }
+                q++;
+            }
+            return sb.toString().trim();
+        }
+
+        /** Index of "key" sitting at depth 1 of {@code obj} and followed by ':'; -1 if absent. */
+        private static int topLevelKeyPos(String obj, String key) {
+            String needle = "\"" + key + "\"";
+            int depth = 0;
+            boolean inStr = false;
+            for (int i = 0; i < obj.length(); i++) {
+                char c = obj.charAt(i);
+                if (inStr) {
+                    if (c == '\\') i++;
+                    else if (c == '"') inStr = false;
+                    continue;
+                }
+                if (c == '"') {
+                    if (depth == 1 && obj.startsWith(needle, i)) {
+                        int colon = skipWs(obj, i + needle.length());
+                        if (colon < obj.length() && obj.charAt(colon) == ':') return i;
+                    }
+                    inStr = true;
+                    continue;
+                }
+                if (c == '{' || c == '[') depth++;
+                else if (c == '}' || c == ']') depth--;
+            }
+            return -1;
+        }
+
+        private static char unescape(char c) {
+            switch (c) {
+                case 'n': return '\n';
+                case 't': return '\t';
+                case 'r': return '\r';
+                case 'b': return '\b';
+                case 'f': return '\f';
+                default:  return c;   // \" \\ \/ and the rest — as is
+            }
+        }
+
+        private static int skipWs(String s, int i) {
+            while (i < s.length() && Character.isWhitespace(s.charAt(i))) i++;
+            return i;
+        }
+    }
+}
