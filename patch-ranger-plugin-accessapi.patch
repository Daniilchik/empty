+package org.apache.ranger.plugin.ipa;
+
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Source of user -> groups mappings.
+ *
+ * {@link IpaLdapClient} can dump the whole directory, so it is synced in the
+ * background by {@link IpaSyncJob}. {@link IpaAccessApiClient} can only query a
+ * single login (bulk endpoints are closed by AccessAPI's role model), so its
+ * groups are resolved lazily with a TTL cache.
+ */
+public interface IpaUserGroupSource {
+
+        /**
+     * Full directory dump: uid -> group names.
+     * Only valid when {@link #supportsFullSync()} returns true.
+     */
+    Map<String, Set<String>> fetchUserGroups() throws Exception;
+
+        /**
+     * Groups of a single user. Empty set when the user is not found —
+     * for Hadoop that is a valid answer, not an error.
+     */
+    Set<String> fetchGroupsForUser(String user) throws Exception;
+
+        /**
+     * true if the source can dump the whole directory and be synced in the
+     * background; false means lazy per-user resolution.
+     */
+    boolean supportsFullSync();
+}
