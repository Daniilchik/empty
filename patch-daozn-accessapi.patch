 {{- if .Values.prometheus.enabled -}}
 {{- range .Values.prometheus.remoteWrite -}}
 {{- if .caKey }}{{- $caKeys = .caKey -}}{{- end -}}
@@ -586,6 +586,7 @@ vault.hashicorp.com/agent-inject-perms-egressgateway-ca: '0400'
                    "egressgateway-prometheus-rw-upstream" $s.prometheusRwCaKey
                    "egressgateway-federate-upstream" $s.federateCaKey
                    "egressgateway-ipa-upstream" $s.ipaCaKey
+                   "egressgateway-accessapi-upstream" $s.accessApiCaKey
                    "egressgateway" $s.egressCaKey -}}
 {{- if $ctx.Values.prometheus.enabled -}}
 {{- range $idx, $rw := $ctx.Values.prometheus.remoteWrite -}}
@@ -648,7 +649,25 @@ Usage: {{ include "kerberos.principal" (dict "ctx" . "service" "scm") }}
 {{- define "ozone.ldap.egressEnabled" -}}
 {{- if gt (len .Values.ldap.hosts) 0 -}}
 {{- if and .Values.hue.enabled .Values.hue.ldap.enabled -}}true
-{{- else if and .Values.ranger.enabled (dig "ipa" "enabled" false .Values.ranger) -}}true
+{{- else if and .Values.ranger.enabled (dig "ipa" "enabled" false .Values.ranger) (eq (dig "ipa" "source" "ldap" .Values.ranger) "ldap") -}}true
+{{- end -}}
+{{- end -}}
+{{- end -}}
+
+{{/*
+  Хост AccessAPI из ranger.ipa.accessApi.url — для ServiceEntry и egress-маршрута.
+*/}}
+{{- define "ozone.accessApi.host" -}}
+{{- $u := dig "ipa" "accessApi" "url" "" .Values.ranger -}}
+{{- if $u -}}
+{{- regexReplaceAll "^https?://([^/:?#]+).*" $u "${1}" -}}
+{{- end -}}
+{{- end -}}
+
+{{- define "ozone.accessApi.egressEnabled" -}}
+{{- if and .Values.ranger.enabled (dig "ipa" "enabled" false .Values.ranger) -}}
+{{- if eq (dig "ipa" "source" "ldap" .Values.ranger) "accessapi" -}}
+{{- if include "ozone.accessApi.host" . -}}true{{- end -}}
 {{- end -}}
 {{- end -}}
 {{- end -}}
