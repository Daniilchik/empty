+{{- if include "ozone.accessApi.egressEnabled" . }}
+  {{- $httpTargets = append $httpTargets (dict "name" "accessapi" "host" (include "ozone.accessApi.host" .) "upstreamPort" 443 "appPort" 80 "listener" 8443 "mtls" true "caKey" $caSecman.accessApiCaKey "upstreamCaFile" "/vault/secrets/egressgateway-accessapi-upstream-ca") }}
+{{- end }}
 {{/*
   Каждый prometheus.remoteWrite[] (если URL http://) уходит через egress
   с TLS origination. Реальный HTTPS upstream port вычисляется из URL
diff --git a/helm-charts/ozone/templates/istio/serviceentry.yaml b/helm-charts/ozone/templates/istio/serviceentry.yaml
index 9cffad2..b4f9e5b 100644
--- a/helm-charts/ozone/templates/istio/serviceentry.yaml
+++ b/helm-charts/ozone/templates/istio/serviceentry.yaml
@@ -262,3 +262,28 @@ spec:
   resolution: DNS
 {{- end }}
 {{- end }}
+{{- if include "ozone.accessApi.egressEnabled" . }}
+{{- $apiHost := include "ozone.accessApi.host" . }}
+---
+apiVersion: networking.istio.io/v1beta1
+kind: ServiceEntry
+metadata:
+  name: {{ include "ozone.fullname" . }}-accessapi-{{ $apiHost | replace "." "-" | trunc 50 | trimSuffix "-" }}
+  namespace: {{ include "ozone.namespace" . }}
+  labels:
+    {{- include "ozone.labels" . | nindent 4 }}
+spec:
+  exportTo:
+    - .
+  hosts:
+    - {{ $apiHost | quote }}
+  location: MESH_EXTERNAL
+  ports:
+    - name: http-accessapi
+      number: 80
+      protocol: HTTP
+    - name: https-accessapi
+      number: 443
+      protocol: HTTPS
+  resolution: DNS
+{{- end }}
