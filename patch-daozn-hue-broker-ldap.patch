diff --git a/helm-charts/ozone/templates/istio/serviceentry.yaml b/helm-charts/ozone/templates/istio/serviceentry.yaml
index b4f9e5b..d5ad311 100644
--- a/helm-charts/ozone/templates/istio/serviceentry.yaml
+++ b/helm-charts/ozone/templates/istio/serviceentry.yaml
@@ -287,3 +287,26 @@ spec:
       protocol: HTTPS
   resolution: DNS
 {{- end }}
+{{- if include "ozone.hue.s3gMtls" . }}
+---
+apiVersion: networking.istio.io/v1beta1
+kind: ServiceEntry
+metadata:
+  name: {{ include "ozone.fullname" . }}-hue-s3g-ingress
+  namespace: {{ include "ozone.namespace" . }}
+  labels:
+    {{- include "ozone.labels" . | nindent 4 }}
+spec:
+  exportTo:
+    - .
+  hosts:
+    - {{ include "ozone.hue.s3gHost" . | quote }}
+  location: MESH_EXTERNAL
+  ports:
+    - name: tls-s3g-ingress
+      number: 443
+      protocol: TLS
+  resolution: DNS
+  endpoints:
+    - address: {{ printf "istio-ingressgateway-%s.%s.svc.%s" .Values.istio.ingressGateway.selectorLabel (include "ozone.namespace" .) .Values.global.clusterDomain }}
+{{- end }}
