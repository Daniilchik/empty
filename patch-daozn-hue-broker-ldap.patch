diff --git a/helm-charts/ozone/templates/_helpers.tpl b/helm-charts/ozone/templates/_helpers.tpl
index 9599a5a..1e435a2 100644
--- a/helm-charts/ozone/templates/_helpers.tpl
+++ b/helm-charts/ozone/templates/_helpers.tpl
@@ -671,3 +671,52 @@ Usage: {{ include "kerberos.principal" (dict "ctx" . "service" "scm") }}
 {{- end -}}
 {{- end -}}
 {{- end -}}
+
+{{- define "ozone.hue.s3gHost" -}}
+{{- include "ozone.ingress.host" (dict "host" .Values.s3g.ingress.host "component" .Values.s3g.serviceName "ctx" .) -}}
+{{- end -}}
+
+{{- define "ozone.hue.s3gMtls" -}}
+{{- if .Values.hue.enabled -}}
+{{- if not .Values.global.security.kerberos.enabled -}}
+{{- fail "hue requires global.security.kerberos.enabled (per-user S3G secrets are issued over SPNEGO and mTLS)" -}}
+{{- end -}}
+{{- $s3gHost := include "ozone.hue.s3gHost" . -}}
+{{- $mutual := false -}}
+{{- range (include "ozone.ingressGateway.tlsHosts" . | fromJsonArray) -}}
+{{- if and (eq .host $s3gHost) .mutual -}}{{- $mutual = true -}}{{- end -}}
+{{- end -}}
+{{- if not (and .Values.istio.enabled .Values.istio.ingressGateway.enabled $mutual) -}}
+{{- fail "hue requires s3g.enabled, s3g.ingress.enabled, s3g.ingress.secman.tls, secman.enabled, istio.enabled and istio.ingressGateway.enabled (Hue reaches S3G only over mTLS via the ingress gateway)" -}}
+{{- end -}}
+true
+{{- end -}}
+{{- end -}}
+
+{{- define "ozone.hue.s3gClientCommonName" -}}
+{{- if .Values.hue.s3g.clientCommonName -}}
+{{- .Values.hue.s3g.clientCommonName -}}
+{{- else -}}
+{{- printf "hue-client-ozone-%s.%s" (include "ozone.namespace" .) .Values.global.ingress.baseDomain -}}
+{{- end -}}
+{{- end -}}
+
+{{- define "ozone.hue.s3gVaultAnnotations" -}}
+{{- $fetch := include "ozone.secman.certPath" . -}}
+{{- $cn := include "ozone.hue.s3gClientCommonName" . -}}
+vault.hashicorp.com/agent-inject-secret-hue-s3g-client.pem: 'true'
+vault.hashicorp.com/agent-inject-template-hue-s3g-client.pem: |
+  {{`{{- with secret `}}"{{ $fetch }}" "common_name={{ $cn }}" "alt_names={{ $cn }}" "format=pem"{{` -}}`}}
+  {{`{{ .Data.certificate }}`}}
+  {{`{{ .Data.issuing_ca }}`}}
+  {{`{{ .Data.private_key }}`}}
+  {{`{{- end }}`}}
+vault.hashicorp.com/agent-inject-perms-hue-s3g-client.pem: '0440'
+vault.hashicorp.com/agent-inject-secret-hue-s3g-ca.pem: 'true'
+vault.hashicorp.com/agent-inject-template-hue-s3g-ca.pem: |
+  {{`{{- with secret `}}"{{ $fetch }}" "common_name={{ $cn }}" "alt_names={{ $cn }}" "format=pem"{{` -}}`}}
+  {{`{{ .Data.issuing_ca }}`}}
+  {{`{{ .Data.root_cert }}`}}
+  {{`{{- end }}`}}
+vault.hashicorp.com/agent-inject-perms-hue-s3g-ca.pem: '0440'
+{{- end -}}
