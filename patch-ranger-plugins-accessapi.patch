+package org.apache.ranger.plugin.ipa;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Ленивый резолвер групп поверх источника, который не умеет полную выгрузку
+ * (AccessAPI). Держит per-user кеш с TTL.
+ *
+ * Поведение при недоступности источника намеренно консервативное: если есть
+ * протухшая запись, отдаём её, а не пустой список. Пустой список для Hadoop
+ * означает "у пользователя нет групп" и молча срежет Ranger-политики, поэтому
+ * протухшие данные тут безопаснее свежего "ничего".
+ */
+public class IpaLazyGroupResolver {
+    private static final Logger LOG = LoggerFactory.getLogger(IpaLazyGroupResolver.class);
+
+    private final IpaUserGroupSource source;
+    private final long               ttlMs;
+    private final long               negativeTtlMs;
+
+    private final ConcurrentHashMap<String, Entry>  cache = new ConcurrentHashMap<>();
+    /** Ключи single-flight: по одному пользователю — один запрос к API. */
+    private final ConcurrentHashMap<String, Object> locks = new ConcurrentHashMap<>();
+
+    public IpaLazyGroupResolver(IpaUserGroupSource source, long ttlMs, long negativeTtlMs) {
+        this.source        = source;
+        this.ttlMs         = ttlMs;
+        this.negativeTtlMs = negativeTtlMs;
+    }
+
+    public Set<String> groupsOf(String user) {
+        if (user == null || user.isEmpty()) return Collections.emptySet();
+
+        Entry cached = cache.get(user);
+        long now = System.currentTimeMillis();
+        if (cached != null && now < cached.expiresAt) {
+            return cached.groups;
+        }
+
+        // Single-flight: параллельные запросы по одному пользователю не должны
+        // порождать несколько обращений к API.
+        Object lock = locks.computeIfAbsent(user, k -> new Object());
+        try {
+            synchronized (lock) {
+                // Пока ждали — мог обновить другой поток.
+                Entry again = cache.get(user);
+                if (again != null && System.currentTimeMillis() < again.expiresAt) {
+                    return again.groups;
+                }
+                return fetchAndCache(user, cached);
+            }
+        } finally {
+            locks.remove(user, lock);
+        }
+    }
+
+    private Set<String> fetchAndCache(String user, Entry stale) {
+        try {
+            Set<String> groups = source.fetchGroupsForUser(user);
+            Set<String> immutable = Collections.unmodifiableSet(new HashSet<>(groups));
+            long ttl = immutable.isEmpty() ? negativeTtlMs : ttlMs;
+            cache.put(user, new Entry(immutable, System.currentTimeMillis() + ttl));
+            if (LOG.isDebugEnabled()) {
+                LOG.debug("resolved {} groups for user={}", immutable.size(), user);
+            }
+            return immutable;
+        } catch (Exception e) {
+            if (stale != null) {
+                // Продлеваем протухшую запись на negativeTtl, чтобы не долбить
+                // недоступный API на каждый запрос авторизации.
+                cache.put(user, new Entry(stale.groups, System.currentTimeMillis() + negativeTtlMs));
+                LOG.warn("AccessAPI lookup failed for user={}, serving stale {} groups: {}",
+                        user, stale.groups.size(), describe(e));
+                if (LOG.isDebugEnabled()) {
+                    LOG.debug("AccessAPI lookup stack trace for user=" + user, e);
+                }
+                return stale.groups;
+            }
+            LOG.warn("AccessAPI lookup failed for user={}, no cached data: {}",
+                    user, describe(e));
+            if (LOG.isDebugEnabled()) {
+                LOG.debug("AccessAPI lookup stack trace for user=" + user, e);
+            }
+            cache.put(user, new Entry(Collections.emptySet(),
+                    System.currentTimeMillis() + negativeTtlMs));
+            return Collections.emptySet();
+        }
+    }
+
+    /**
+     * Разворачивает цепочку причин в одну строку. Без этого в WARN попадает
+     * только обёртка (например SSLException от KerberosAuthenticator), а
+     * настоящая причина — вроде "unable to find valid certification path" —
+     * видна лишь при DEBUG.
+     */
+    private static String describe(Throwable e) {
+        StringBuilder sb = new StringBuilder();
+        Throwable t = e;
+        int depth = 0;
+        while (t != null && depth++ < 5) {
+            if (sb.length() > 0) sb.append(" <- ");
+            sb.append(t.getClass().getSimpleName()).append(": ").append(t.getMessage());
+            if (t.getCause() == t) break;
+            t = t.getCause();
+        }
+        return sb.toString();
+    }
+
+    /** Сбросить кеш (вызывается из cacheGroupsRefresh()). */
+    public void invalidateAll() {
+        cache.clear();
+    }
+
+    /** Точечный сброс. */
+    public void invalidate(String user) {
+        if (user != null) cache.remove(user);
+    }
+
+    public int size() {
+        return cache.size();
+    }
+
+    /** Только для тестов. */
+    Map<String, Entry> snapshot() {
+        return Collections.unmodifiableMap(cache);
+    }
+
+    static final class Entry {
+        final Set<String> groups;
+        final long        expiresAt;
+
+        Entry(Set<String> groups, long expiresAt) {
+            this.groups    = groups;
+            this.expiresAt = expiresAt;
+        }
+    }
+}
