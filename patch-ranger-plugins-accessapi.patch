+    private static final String SAMPLE = "{"
+            + "\"displayname\" : \"Максим Евгеньевич Ушаков\","
+            + "\"name\" : \"u_sklsdpfess_s_corr_risk_dme\","
+            + "\"uid\" : \"u_sklsdpfess_s_corr_risk_dme\","
+            + "\"title\" : \"DOTOOLS-36831\","
+            + "\"as_info\" : [ \"INFRST\" ],"
+            + "\"uidnumber\" : \"1600693725\","
+            + "\"memberof\" : [ \"g_dc_d_custom_risk_dme_tscorr_ro\", \"technology-users\","
+            + " \"allow_all_users\", \"ipausers\" ],"
+            + "\"hbacs\" : [ \"allow_all_users_services\", \"allow_all\" ],"
+            + "\"sudorules\" : [ ],"
+            + "\"locked\" : false"
+            + "}";
+
+    @Test
+    public void extractsMemberofArray() {
+        List<String> groups = IpaAccessApiClient.JsonLite.extractStringArray(SAMPLE, "memberof");
+
+        assertEquals(4, groups.size());
+        assertEquals("g_dc_d_custom_risk_dme_tscorr_ro", groups.get(0));
+        assertTrue(groups.contains("ipausers"));
+    }
+
+    @Test
+    public void doesNotConfuseOtherArrays() {
+        List<String> hbacs = IpaAccessApiClient.JsonLite.extractStringArray(SAMPLE, "hbacs");
+        assertEquals(2, hbacs.size());
+        assertTrue(hbacs.contains("allow_all"));
+
+        List<String> sudo = IpaAccessApiClient.JsonLite.extractStringArray(SAMPLE, "sudorules");
+        assertTrue(sudo.isEmpty());
+    }
+
+    @Test
+    public void missingFieldGivesEmptyList() {
+        assertTrue(IpaAccessApiClient.JsonLite.extractStringArray(SAMPLE, "nosuchfield").isEmpty());
+        assertTrue(IpaAccessApiClient.JsonLite.extractStringArray("", "memberof").isEmpty());
+        assertTrue(IpaAccessApiClient.JsonLite.extractStringArray("{}", "memberof").isEmpty());
+    }
+
+    /** Ответ на поиск по группе — массив объектов, у каждого свой memberof. */
+    @Test
+    public void handlesArrayOfUsers() {
+        String json = "[ {\"uid\":\"a\",\"memberof\":[\"g1\"]}, {\"uid\":\"b\",\"memberof\":[\"g2\",\"g3\"]} ]";
+        List<String> all = IpaAccessApiClient.JsonLite.extractStringArray(json, "memberof");
+        assertEquals(3, all.size());
+    }
+
+    @Test
+    public void unescapesQuotedValues() {
+        String json = "{\"memberof\":[\"g_with_\\\"quote\\\"\",\"g_norm\"]}";
+        List<String> groups = IpaAccessApiClient.JsonLite.extractStringArray(json, "memberof");
+        assertEquals(2, groups.size());
+        assertEquals("g_with_\"quote\"", groups.get(0));
+    }
+
+    @Test
+    public void fullSyncIsNotSupported() {
+        IpaAccessApiClient client = new IpaAccessApiClient(accessApiConfig());
+        assertFalse(client.supportsFullSync());
+        try {
+            client.fetchUserGroups();
+            org.junit.Assert.fail("expected UnsupportedOperationException");
+        } catch (UnsupportedOperationException expected) {
+            assertTrue(expected.getMessage().contains("AccessAPI"));
+        }
+    }
+
+    @Test
+    public void configParsesAccessApiSettings() {
+        IpaConfig cfg = accessApiConfig();
+
+        assertTrue(cfg.isAccessApiSource());
+        assertEquals("https://dataapi.dev.df.sbrf.ru", cfg.getApiUrl());
+        assertEquals(IpaConfig.API_AUTH_KERBEROS, cfg.getApiAuth());
+        assertFalse(cfg.isApiAuthMtls());
+        // Служебные группы по умолчанию отфильтровываются.
+        assertTrue(cfg.getGroupExclude().contains("ipausers"));
+        assertTrue(cfg.getGroupExclude().contains("allow_all_users"));
+    }
+
+    @Test
+    public void trailingSlashInUrlIsTrimmed() {
+        Configuration conf = baseConf();
+        conf.set(IpaConfig.API_URL, "https://dataapi.dev.df.sbrf.ru///");
+        assertEquals("https://dataapi.dev.df.sbrf.ru", new IpaConfig(conf).getApiUrl());
+    }
+
+    @Test
+    public void ldapSettingsNotRequiredForAccessApiSource() {
+        // Ни ldap.url, ни bind-файлов нет — конструктор не должен падать.
+        IpaConfig cfg = accessApiConfig();
+        assertTrue(cfg.isEnabled());
+    }
+
+    @Test(expected = IllegalStateException.class)
+    public void mtlsRequiresClientCert() {
+        Configuration conf = baseConf();
+        conf.set(IpaConfig.API_URL,  "https://dataapi-mtls.dev.df.sbrf.ru");
+        conf.set(IpaConfig.API_AUTH, IpaConfig.API_AUTH_MTLS);
+        new IpaConfig(conf);
+    }
+
+    @Test(expected = IllegalStateException.class)
+    public void unknownAuthModeRejected() {
+        Configuration conf = baseConf();
+        conf.set(IpaConfig.API_URL,  "https://dataapi.dev.df.sbrf.ru");
+        conf.set(IpaConfig.API_AUTH, "basic");
+        new IpaConfig(conf);
+    }
+
+    @Test(expected = IllegalStateException.class)
+    public void apiUrlIsRequired() {
+        new IpaConfig(baseConf());
+    }
+
+    @Test
+    public void apiPrincipalAndKeytabAreReadWhenSet() {
+        Configuration conf = baseConf();
+        conf.set(IpaConfig.API_URL, "http://dataapi.dev.df.sbrf.ru");
+        conf.set(IpaConfig.API_PRINCIPAL, "u_sdp_s_accessapi@DEV.DF.SBRF.RU");
+        conf.set(IpaConfig.API_KEYTAB, "/vault/secrets/om-accessapi.keytab");
+
+        IpaConfig cfg = new IpaConfig(conf);
+        assertEquals("u_sdp_s_accessapi@DEV.DF.SBRF.RU", cfg.getApiPrincipal());
+        assertEquals("/vault/secrets/om-accessapi.keytab", cfg.getApiKeytab());
+    }
+
+    @Test
+    public void gatewayAuthNeedsNoClientCredentials() {
+        // Аутентифицирует egress gateway своим сертификатом — от приложения
+        // не требуется ни keytab, ни клиентский сертификат.
+        Configuration conf = baseConf();
+        conf.set(IpaConfig.API_URL, "http://dataapi-mtls.dev.df.sbrf.ru");
+        conf.set(IpaConfig.API_AUTH, IpaConfig.API_AUTH_GATEWAY);
+
+        IpaConfig cfg = new IpaConfig(conf);
+        assertTrue(cfg.isApiAuthGateway());
+        assertFalse(cfg.isApiAuthMtls());
+        assertNull(cfg.getApiClientCert());
+    }
+
+    @Test(expected = IllegalStateException.class)
+    public void unknownAuthModeIsRejected() {
+        Configuration conf = baseConf();
+        conf.set(IpaConfig.API_URL, "http://dataapi.dev.df.sbrf.ru");
+        conf.set(IpaConfig.API_AUTH, "basic");
+        new IpaConfig(conf);
+    }
+
+    @Test
+    public void apiPrincipalIsOptionalAndFallsBackToDaemonIdentity() {
+        IpaConfig cfg = accessApiConfig();
+        assertNull(cfg.getApiPrincipal());
+        assertNull(cfg.getApiKeytab());
+    }
+
+    private static Configuration baseConf() {
+        Configuration conf = new Configuration(false);
+        conf.setBoolean(IpaConfig.ENABLED, true);
+        conf.set(IpaConfig.SOURCE, IpaConfig.SOURCE_ACCESS_API);
+        return conf;
+    }
+
+    private static IpaConfig accessApiConfig() {
+        Configuration conf = baseConf();
+        conf.set(IpaConfig.API_URL, "https://dataapi.dev.df.sbrf.ru");
+        return new IpaConfig(conf);
+    }
+}
