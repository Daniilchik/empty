+package org.apache.ranger.plugin.ipa;
+
+import org.apache.hadoop.security.UserGroupInformation;
+import org.apache.hadoop.security.authentication.client.AuthenticatedURL;
+import org.apache.hadoop.security.authentication.client.KerberosAuthenticator;
+import org.apache.hadoop.security.authentication.client.ConnectionConfigurator;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import javax.net.ssl.HttpsURLConnection;
+import javax.net.ssl.KeyManagerFactory;
+import javax.net.ssl.SSLContext;
+import javax.net.ssl.SSLSocketFactory;
+import javax.net.ssl.TrustManager;
+import javax.net.ssl.TrustManagerFactory;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.Reader;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.security.KeyFactory;
+import java.security.KeyStore;
+import java.security.PrivateKey;
+import java.security.cert.Certificate;
+import java.security.cert.CertificateFactory;
+import java.security.spec.PKCS8EncodedKeySpec;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * Клиент AccessAPI (СУДиС), заменяющий прямой поход в FreeIPA по LDAP.
+ *
+ * Используется один эндпоинт — {@code GET /idm/find?login=<LOGIN>}; из ответа
+ * берётся поле {@code memberof}. Полная выгрузка каталога недоступна: эндпоинты
+ * /idm/groups и /idm/allgroups закрыты ролевой моделью, поэтому
+ * {@link #supportsFullSync()} возвращает false, а группы резолвятся лениво
+ * через {@link IpaLazyGroupResolver}.
+ *
+ * Аутентификация — SPNEGO (по keytab сервиса) либо mTLS с клиентским
+ * сертификатом; выбирается настройкой {@link IpaConfig#API_AUTH}.
+ */
+public class IpaAccessApiClient implements IpaUserGroupSource {
+    private static final Logger LOG = LoggerFactory.getLogger(IpaAccessApiClient.class);
+
+    private final IpaConfig cfg;
+    private final AtomicReference<SSLSocketFactory> mtlsFactory  = new AtomicReference<>();
+    private final AtomicReference<SSLSocketFactory> trustFactory = new AtomicReference<>();
+    private final AtomicReference<UserGroupInformation> apiUgi   = new AtomicReference<>();
+
+    public IpaAccessApiClient(IpaConfig cfg) {
+        this.cfg = cfg;
+    }
+
+    @Override
+    public boolean supportsFullSync() {
+        return false;
+    }
+
+    @Override
+    public Map<String, Set<String>> fetchUserGroups() {
+        throw new UnsupportedOperationException(
+                "AccessAPI не отдаёт весь каталог: /idm/groups и /idm/allgroups закрыты ролевой "
+                        + "моделью. Группы резолвятся лениво по одному пользователю.");
+    }
+
+    @Override
+    public Set<String> fetchGroupsForUser(String user) throws IOException {
+        String url = cfg.getApiUrl() + "/idm/find?login="
+                + URLEncoder.encode(user, StandardCharsets.UTF_8.name());
+
+        String body = get(url);
+        if (body == null || body.isEmpty()) {
+            return Collections.emptySet();
+        }
+
+        Set<String> groups = new LinkedHashSet<>();
+        for (String g : JsonLite.extractStringArray(body, "memberof")) {
+            if (!cfg.getGroupExclude().contains(g)) {
+                groups.add(g);
+            }
+        }
+        return groups;
+    }
+
+    // ──────────────────────────── HTTP ────────────────────────────
+
+    private String get(String url) throws IOException {
+        HttpURLConnection conn;
+        if (cfg.isApiAuthGateway()) {
+            conn = openPlain(url);
+        } else if (cfg.isApiAuthMtls()) {
+            conn = openMtls(url);
+        } else {
+            conn = openSpnego(url);
+        }
+        conn.setRequestMethod("GET");
+        conn.setConnectTimeout(cfg.getConnectTimeoutMs());
+        conn.setReadTimeout(cfg.getReadTimeoutMs());
+        conn.setRequestProperty("Accept", "application/json");
+
+        try {
+            int code = conn.getResponseCode();
+            if (code == HttpURLConnection.HTTP_NOT_FOUND) {
+                // Пользователя нет в каталоге — валидный ответ, не ошибка.
+                return null;
+            }
+            if (code != HttpURLConnection.HTTP_OK) {
+                throw new IOException("AccessAPI returned HTTP " + code + " for " + stripQuery(url)
+                        + (code == HttpURLConnection.HTTP_UNAUTHORIZED
+                        || code == HttpURLConnection.HTTP_FORBIDDEN
+                        ? " (проверьте членство сервисной УЗ в группе доступа)" : ""));
+            }
+            try (InputStream in = conn.getInputStream()) {
+                return readAll(in);
+            }
+        } finally {
+            conn.disconnect();
+        }
+    }
+
+    /**
+     * SPNEGO. Токен намеренно создаётся на каждый запрос: он живёт недолго,
+     * а расшаривать его между потоками небезопасно (AuthenticatedURL.Token
+     * изменяемый и не потокобезопасный).
+     *
+     * Если задан {@link IpaConfig#API_CA_CERT}, TLS проверяется по нему, а не
+     * по JVM truststore: сертификат AccessAPI обычно подписан корпоративным CA,
+     * которого в cacerts образа нет — иначе получаем SSLException ещё до SPNEGO.
+     */
+    private HttpURLConnection openSpnego(String url) throws IOException {
+        final SSLSocketFactory factory = trustOnlySocketFactory();
+        final ConnectionConfigurator configurator = conn -> {
+            if (factory != null && conn instanceof HttpsURLConnection) {
+                ((HttpsURLConnection) conn).setSSLSocketFactory(factory);
+            }
+            return conn;
+        };
+        try {
+            return apiUgi().doAs(
+                    (java.security.PrivilegedExceptionAction<HttpURLConnection>) () -> {
+                        AuthenticatedURL.Token token = new AuthenticatedURL.Token();
+                        return new AuthenticatedURL(new KerberosAuthenticator(), configurator)
+                                .openConnection(new URL(url), token);
+                    });
+        } catch (IOException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IOException("SPNEGO request failed for " + stripQuery(url), e);
+        }
+    }
+
+    /**
+     * Запрос без клиентских креденшелов на стороне приложения.
+     *
+     * Режим {@value IpaConfig#API_AUTH_GATEWAY}: аутентификацию выполняет egress
+     * gateway — он терминирует трафик и предъявляет AccessAPI клиентский
+     * сертификат (mode=MUTUAL), CN которого зарегистрирован в СУДиС. Плагин
+     * при этом шлёт обычный HTTP внутрь mesh, где хоп до gateway защищён mTLS
+     * самого mesh. Kerberos не участвует — это снимает проблему обращения к
+     * сервису в чужом realm.
+     */
+    private HttpURLConnection openPlain(String url) throws IOException {
+        return (HttpURLConnection) new URL(url).openConnection();
+    }
+
+    /**
+     * UGI, от имени которого идёт запрос к AccessAPI.
+     *
+     * По умолчанию — принципал самого демона. Но AccessAPI живёт в корпоративном
+     * realm, и группа доступа выдаётся корпоративной ТУЗ; принципал вида
+     * om/om@<realm кластера> в неё не входит и без cross-realm доверия даже не
+     * получит service ticket. Поэтому при заданных {@link IpaConfig#API_PRINCIPAL}
+     * и {@link IpaConfig#API_KEYTAB} логинимся отдельной УЗ и ходим от неё.
+     */
+    private UserGroupInformation apiUgi() throws IOException {
+        String principal = cfg.getApiPrincipal();
+        String keytab    = cfg.getApiKeytab();
+        if (principal == null || principal.isEmpty() || keytab == null || keytab.isEmpty()) {
+            return UserGroupInformation.getLoginUser();
+        }
+        UserGroupInformation ugi = apiUgi.get();
+        if (ugi == null) {
+            synchronized (apiUgi) {
+                ugi = apiUgi.get();
+                if (ugi == null) {
+                    ugi = UserGroupInformation
+                            .loginUserFromKeytabAndReturnUGI(principal, keytab);
+                    apiUgi.set(ugi);
+                    LOG.info("AccessAPI: authenticating as {} (keytab {})", principal, keytab);
+                }
+            }
+        }
+        // UGI из loginUserFromKeytabAndReturnUGI не обновляется фоновым renewer'ом,
+        // поэтому продлеваем сами — иначе через lifetime билета всё встанет.
+        ugi.checkTGTAndReloginFromKeytab();
+        return ugi;
+    }
+
+    /** Truststore из {@link IpaConfig#API_CA_CERT}; null — использовать JVM-дефолт. */
+    private SSLSocketFactory trustOnlySocketFactory() throws IOException {
+        String ca = cfg.getApiCaCert();
+        if (ca == null || ca.isEmpty()) {
+            return null;
+        }
+        SSLSocketFactory cached = trustFactory.get();
+        if (cached != null) return cached;
+        try {
+            SSLContext ctx = SSLContext.getInstance("TLS");
+            ctx.init(null, buildTrustManagers(ca), null);
+            SSLSocketFactory f = ctx.getSocketFactory();
+            trustFactory.set(f);
+            return f;
+        } catch (IOException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IOException("failed to build trust store from " + ca, e);
+        }
+    }
+
+    private TrustManager[] buildTrustManagers(String caPath) throws Exception {
+        KeyStore ts = KeyStore.getInstance(KeyStore.getDefaultType());
+        ts.load(null, null);
+        int i = 0;
+        for (Certificate c : readCertificates(caPath)) {
+            ts.setCertificateEntry("accessapi-ca-" + (i++), c);
+        }
+        TrustManagerFactory tmf =
+                TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm());
+        tmf.init(ts);
+        return tmf.getTrustManagers();
+    }
+
+    private HttpURLConnection openMtls(String url) throws IOException {
+        URL u = new URL(url);
+        HttpURLConnection conn = (HttpURLConnection) u.openConnection();
+        if (conn instanceof HttpsURLConnection) {
+            ((HttpsURLConnection) conn).setSSLSocketFactory(mtlsSocketFactory());
+        } else {
+            LOG.warn("{}={} is not https, client certificate will not be used",
+                    IpaConfig.API_URL, stripQuery(url));
+        }
+        return conn;
+    }
+
+    private SSLSocketFactory mtlsSocketFactory() throws IOException {
+        SSLSocketFactory cached = mtlsFactory.get();
+        if (cached != null) return cached;
+
+        try {
+            KeyStore ks = KeyStore.getInstance(KeyStore.getDefaultType());
+            ks.load(null, null);
+            ks.setKeyEntry("client",
+                    readPrivateKey(cfg.getApiClientKey()),
+                    new char[0],
+                    readCertChain(cfg.getApiClientCert()));
+
+            KeyManagerFactory kmf =
+                    KeyManagerFactory.getInstance(KeyManagerFactory.getDefaultAlgorithm());
+            kmf.init(ks, new char[0]);
+
+            TrustManager[] trustManagers = null;
+            if (cfg.getApiCaCert() != null && !cfg.getApiCaCert().isEmpty()) {
+                trustManagers = buildTrustManagers(cfg.getApiCaCert());
+            }
+
+            SSLContext ctx = SSLContext.getInstance("TLS");
+            ctx.init(kmf.getKeyManagers(), trustManagers, null);
+            SSLSocketFactory f = ctx.getSocketFactory();
+            mtlsFactory.set(f);
+            return f;
+        } catch (IOException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IOException("failed to build mTLS context from "
+                    + cfg.getApiClientCert() + " / " + cfg.getApiClientKey(), e);
+        }
+    }
+
+    // ──────────────────────────── PEM ────────────────────────────
+
+    private static Certificate[] readCertChain(String path) throws IOException {
+        Collection<? extends Certificate> certs = readCertificates(path);
+        return certs.toArray(new Certificate[0]);
+    }
+
+    private static Collection<? extends Certificate> readCertificates(String path)
+            throws IOException {
+        try (InputStream in = Files.newInputStream(Paths.get(path))) {
+            CertificateFactory cf = CertificateFactory.getInstance("X.509");
+            return cf.generateCertificates(in);
+        } catch (java.security.cert.CertificateException e) {
+            throw new IOException("failed to read certificates from " + path, e);
+        }
+    }
+
+    /** Ожидается PKCS#8 PEM ({@code -----BEGIN PRIVATE KEY-----}) — формат, который отдаёт Vault. */
+    private static PrivateKey readPrivateKey(String path) throws IOException {
+        String pem = new String(Files.readAllBytes(Paths.get(path)), StandardCharsets.UTF_8);
+        String base64 = pem
+                .replaceAll("-----BEGIN (RSA )?PRIVATE KEY-----", "")
+                .replaceAll("-----END (RSA )?PRIVATE KEY-----", "")
+                .replaceAll("\\s", "");
+        if (base64.isEmpty()) {
+            throw new IOException("no PEM private key found in " + path);
+        }
+        byte[] der = Base64.getDecoder().decode(base64);
+        try {
+            return KeyFactory.getInstance("RSA")
+                    .generatePrivate(new PKCS8EncodedKeySpec(der));
+        } catch (Exception e) {
+            throw new IOException("failed to parse private key from " + path
+                    + " (ожидается PKCS#8: -----BEGIN PRIVATE KEY-----)", e);
+        }
+    }
+
+    // ──────────────────────────── utils ────────────────────────────
+
+    private static String readAll(InputStream in) throws IOException {
+        StringBuilder sb = new StringBuilder();
+        try (Reader r = new InputStreamReader(in, StandardCharsets.UTF_8)) {
+            char[] buf = new char[4096];
+            int n;
+            while ((n = r.read(buf)) > 0) {
+                sb.append(buf, 0, n);
+            }
+        }
+        return sb.toString();
+    }
+
+    /** Логин не должен попадать в логи/сообщения об ошибках. */
+    private static String stripQuery(String url) {
+        int q = url.indexOf('?');
+        return q < 0 ? url : url.substring(0, q);
+    }
+
+    /**
+     * Минимальный разбор JSON под одну задачу: достать строковый массив по имени поля.
+     *
+     * Полноценный парсер (Jackson) сюда сознательно не тащим: модуль грузится
+     * через ranger-plugin-classloader, и лишняя зависимость рискует разъехаться
+     * с версией в runtime. Нужен ровно один тип значения — массив строк.
+     */
+    static final class JsonLite {
+        private JsonLite() {}
+
+        static List<String> extractStringArray(String json, String field) {
+            List<String> out = new ArrayList<>();
+            String needle = "\"" + field + "\"";
+            int from = 0;
+            while (true) {
+                int k = json.indexOf(needle, from);
+                if (k < 0) break;
+                int colon = json.indexOf(':', k + needle.length());
+                if (colon < 0) break;
+
+                int p = skipWs(json, colon + 1);
+                if (p >= json.length() || json.charAt(p) != '[') {
+                    from = k + needle.length();
+                    continue;
+                }
+                p++; // '['
+                while (p < json.length()) {
+                    p = skipWs(json, p);
+                    if (p >= json.length() || json.charAt(p) == ']') break;
+                    if (json.charAt(p) == ',') { p++; continue; }
+                    if (json.charAt(p) != '"') break;
+                    StringBuilder sb = new StringBuilder();
+                    p++; // открывающая кавычка
+                    while (p < json.length() && json.charAt(p) != '"') {
+                        char c = json.charAt(p);
+                        if (c == '\\' && p + 1 < json.length()) {
+                            p++;
+                            sb.append(unescape(json.charAt(p)));
+                        } else {
+                            sb.append(c);
+                        }
+                        p++;
+                    }
+                    p++; // закрывающая кавычка
+                    String v = sb.toString().trim();
+                    if (!v.isEmpty()) out.add(v);
+                }
+                from = p;
+            }
+            return out;
+        }
+
+        private static char unescape(char c) {
+            switch (c) {
+                case 'n': return '\n';
+                case 't': return '\t';
+                case 'r': return '\r';
+                case 'b': return '\b';
+                case 'f': return '\f';
+                default:  return c;   // \" \\ \/ и прочее — как есть
+            }
+        }
+
+        private static int skipWs(String s, int i) {
+            while (i < s.length() && Character.isWhitespace(s.charAt(i))) i++;
+            return i;
+        }
+    }
+}
