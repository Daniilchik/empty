+package org.apache.ranger.plugin.ipa;
+
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Источник соответствия "пользователь -> группы".
+ *
+ * Две реализации отличаются тем, какие запросы им доступны:
+ *
+ *  - {@link IpaLdapClient} читает FreeIPA по LDAP и умеет выгрузить весь
+ *    каталог разом ({@link #fetchUserGroups()}), поэтому работает через
+ *    периодический {@link IpaSyncJob} со снапшотом в {@link IpaUserGroupCache}.
+ *
+ *  - {@link IpaAccessApiClient} ходит в AccessAPI по HTTP. Полная выгрузка
+ *    там недоступна (эндпоинты /idm/groups и /idm/allgroups закрыты ролевой
+ *    моделью), доступен только запрос по конкретному логину — поэтому группы
+ *    резолвятся лениво, по запросу, с TTL-кешем.
+ */
+public interface IpaUserGroupSource {
+
+    /**
+     * Полная выгрузка каталога: uid -> набор имён групп.
+     * Вызывать только если {@link #supportsFullSync()} вернул true.
+     */
+    Map<String, Set<String>> fetchUserGroups() throws Exception;
+
+    /**
+     * Группы одного пользователя. Пустое множество, если пользователь
+     * не найден — это не ошибка (у Hadoop "нет групп" - валидный ответ).
+     */
+    Set<String> fetchGroupsForUser(String user) throws Exception;
+
+    /**
+     * true, если источник умеет отдавать весь каталог разом и его можно
+     * синкать в фоне; false — резолвим лениво по одному пользователю.
+     */
+    boolean supportsFullSync();
+}
