+package org.apache.ranger.plugin.ipa;
+
+import org.junit.Test;
+
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+public class IpaLazyGroupResolverTest {
+
+    /** Источник-заглушка: считает вызовы, умеет падать по требованию. */
+    private static final class StubSource implements IpaUserGroupSource {
+        final AtomicInteger calls = new AtomicInteger();
+        volatile Set<String> groups = set("g1", "g2");
+        volatile boolean fail;
+
+        @Override public boolean supportsFullSync() { return false; }
+
+        @Override public Map<String, Set<String>> fetchUserGroups() {
+            throw new UnsupportedOperationException();
+        }
+
+        @Override public Set<String> fetchGroupsForUser(String user) throws Exception {
+            calls.incrementAndGet();
+            if (fail) throw new java.io.IOException("AccessAPI unavailable");
+            return groups;
+        }
+    }
+
+    @Test
+    public void resolvesAndCaches() {
+        StubSource src = new StubSource();
+        IpaLazyGroupResolver r = new IpaLazyGroupResolver(src, 60_000L, 10_000L);
+
+        assertEquals(set("g1", "g2"), r.groupsOf("alice"));
+        assertEquals(set("g1", "g2"), r.groupsOf("alice"));
+        assertEquals("второй вызов должен прийти из кеша", 1, src.calls.get());
+    }
+
+    @Test
+    public void refetchesAfterTtl() throws Exception {
+        StubSource src = new StubSource();
+        IpaLazyGroupResolver r = new IpaLazyGroupResolver(src, 30L, 10L);
+
+        r.groupsOf("alice");
+        Thread.sleep(60L);
+        r.groupsOf("alice");
+
+        assertEquals(2, src.calls.get());
+    }
+
+    @Test
+    public void emptyResultUsesNegativeTtl() throws Exception {
+        StubSource src = new StubSource();
+        src.groups = Collections.emptySet();
+        IpaLazyGroupResolver r = new IpaLazyGroupResolver(src, 60_000L, 30L);
+
+        assertTrue(r.groupsOf("ghost").isEmpty());
+        assertEquals(1, src.calls.get());
+
+        // В пределах negative TTL повторного запроса нет.
+        assertTrue(r.groupsOf("ghost").isEmpty());
+        assertEquals(1, src.calls.get());
+
+        Thread.sleep(60L);
+        r.groupsOf("ghost");
+        assertEquals(2, src.calls.get());
+    }
+
+    /**
+     * Ключевое поведение: при недоступности API отдаём протухшие данные, а не
+     * пустой список — иначе Ranger молча срежет доступ пользователю.
+     */
+    @Test
+    public void servesStaleWhenSourceFails() throws Exception {
+        StubSource src = new StubSource();
+        IpaLazyGroupResolver r = new IpaLazyGroupResolver(src, 30L, 10L);
+
+        assertEquals(set("g1", "g2"), r.groupsOf("alice"));
+
+        src.fail = true;
+        Thread.sleep(60L);
+
+        assertEquals("должны получить протухший кеш, а не пустоту",
+                set("g1", "g2"), r.groupsOf("alice"));
+    }
+
+    @Test
+    public void returnsEmptyWhenSourceFailsAndNoCache() {
+        StubSource src = new StubSource();
+        src.fail = true;
+        IpaLazyGroupResolver r = new IpaLazyGroupResolver(src, 60_000L, 10_000L);
+
+        assertTrue(r.groupsOf("alice").isEmpty());
+    }
+
+    @Test
+    public void nullAndEmptyUserAreSafe() {
+        StubSource src = new StubSource();
+        IpaLazyGroupResolver r = new IpaLazyGroupResolver(src, 60_000L, 10_000L);
+
+        assertTrue(r.groupsOf(null).isEmpty());
+        assertTrue(r.groupsOf("").isEmpty());
+        assertEquals("источник не должен вызываться", 0, src.calls.get());
+    }
+
+    @Test
+    public void invalidateForcesRefetch() {
+        StubSource src = new StubSource();
+        IpaLazyGroupResolver r = new IpaLazyGroupResolver(src, 60_000L, 10_000L);
+
+        r.groupsOf("alice");
+        r.invalidateAll();
+        r.groupsOf("alice");
+
+        assertEquals(2, src.calls.get());
+    }
+
+    /** Параллельные запросы по одному пользователю не должны множить обращения к API. */
+    @Test
+    public void singleFlightForSameUser() throws Exception {
+        StubSource src = new StubSource();
+        IpaLazyGroupResolver r = new IpaLazyGroupResolver(src, 60_000L, 10_000L);
+
+        int threads = 16;
+        ExecutorService pool = Executors.newFixedThreadPool(threads);
+        CountDownLatch start = new CountDownLatch(1);
+        CountDownLatch done  = new CountDownLatch(threads);
+
+        for (int i = 0; i < threads; i++) {
+            pool.submit(() -> {
+                try {
+                    start.await();
+                    r.groupsOf("alice");
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                } finally {
+                    done.countDown();
+                }
+            });
+        }
+
+        start.countDown();
+        assertTrue(done.await(10, TimeUnit.SECONDS));
+        pool.shutdown();
+
+        assertEquals("ожидался один запрос к источнику", 1, src.calls.get());
+    }
+
+    private static Set<String> set(String... values) {
+        return new HashSet<>(java.util.Arrays.asList(values));
+    }
+}
