+metadata:
+  name: {{ include "ozone.fullname" $ }}-kdc-{{ $h | replace "." "-" | trunc 45 | trimSuffix "-" }}
+  namespace: {{ include "ozone.namespace" $ }}
+  labels:
+    {{- include "ozone.labels" $ | nindent 4 }}
+spec:
+  exportTo:
+    - .
+  hosts:
+    - {{ $h | quote }}
+  location: MESH_EXTERNAL
+  ports:
+    - name: tcp-kerberos
+      number: {{ $p | int }}
+      protocol: TCP
+  resolution: DNS
+{{- end }}
