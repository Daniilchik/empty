+    {{- include "ozone.labels" . | nindent 4 }}
+spec:
+  exportTo:
+    - .
+  hosts:
+    - {{ $apiHost | quote }}
+  location: MESH_EXTERNAL
+  ports:
+    - name: http-accessapi
+      number: 80
+      protocol: HTTP
+    - name: https-accessapi
+      number: 443
+      protocol: HTTPS
+  resolution: DNS
+{{- end }}
+{{- range $r := .Values.global.security.kerberos.extraRealms }}
+{{- $h := regexReplaceAll "^([^:]+).*" $r.kdc "${1}" }}
+{{- $p := regexReplaceAll "^[^:]+:?([0-9]*)$" $r.kdc "${1}" | default "88" }}
