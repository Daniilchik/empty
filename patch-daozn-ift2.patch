diff --git a/values/values-ift2.yaml b/values/values-ift2.yaml
new file mode 100644
index 0000000..59fb074
--- /dev/null
+++ b/values/values-ift2.yaml
@@ -0,0 +1,313 @@
+# Второй кластер IFT (behe4mln). Контур тот же — qa.df.sbrf.ru,
+# поэтому realm, KDC, LDAP, Ranger и AccessAPI совпадают с values-ift.yaml.
+# Отличаются: узлы, домен ingress, адреса БД и параметры регистрации.
+#
+# ЗАПОЛНИТЬ ПЕРЕД ПЕРВЫМ ДЕПЛОЕМ — все места помечены TODO(ift2).
+
+global:
+  image:
+    registry: docker-release.registry-ci.delta.sbrf.ru/ci15207061/ci15207061
+    repository: ozone@sha256
+    tag: 36400ea16db93dc50dcf70848059b1654fe9b036c5566ef7138065d7ec55a8bf
+    pullSecrets:
+      - name: registry-secret
+  ingress:
+    baseDomain: "apps.behe4mln.k8s.delta.sbrf.ru"
+  clusterName: "behe4mln"
+  storage:
+    mode: storageClass
+    storageClass:
+      namePrefix: lvms
+      om:
+        diskIndex: lv01
+        size: "10Gi"
+      scm:
+        diskIndex: lv02
+        size: "10Gi"
+      datanode:
+        # TODO(ift2): сверить с фактической разметкой дисков на новых узлах —
+        # число индексов и размер тома зависят от железа, вслепую копировать нельзя.
+        diskIndices:
+          - lv01
+          - lv02
+          - lv03
+          - lv04
+          - lv05
+          - lv06
+          - lv07
+          - lv08
+          - lv09
+        size: "5680857126400"
+  security:
+    kerberos:
+      realm: "QA.DF.SBRF.RU"
+      principal:
+        # Имени кластера в принципале нет — SPN одинаковы с существующим ift,
+        # значит подходит тот же keytab из secman.
+        pattern: "{{ .Service }}/{{ .Subdomain }}.qa.df.sbrf.ru@{{ .Realm }}"
+      kdc:
+        hostname: "tvlds-acc000035.qa.df.sbrf.ru"
+        ipAddress: 10.86.3.115
+
+metalLb:
+  enabled: true
+  image:
+    repository: kube-api@sha256
+    tag: 673eaf462baa094055832020ad8920ecbf0f6a9c37dff70c89125549ffcd7ddb # 1.4.1.13.1
+
+# Путь и namespace те же, что у существующего ift.
+# TODO(ift2): подать заявку в secman — Vault должен доверять НОВОМУ кластеру
+# (свой kubernetes auth mount + роль с именем namespace развёртывания),
+# иначе Vault Agent не сможет получить секреты. Сам путь менять не нужно.
+secman:
+  hostname: t.secrets.delta.sbrf.ru
+  path: A/CI07978178/OSH/SDPCOMPUTE/KV/ozone
+  certPath: CI04159629_CI07978178/A/CI07978178/OSH/SDPCOMPUTE/SBERCA/sberca-test-ext-g2/fetch/server-client_1y_DROPAPP_rsa
+  namespace: CI04159629_CI07978178
+
+ldap:
+  hosts:
+    - tvlds-acc000035.qa.df.sbrf.ru
+  port: 636
+  baseDn: "cn=accounts,dc=qa,dc=df,dc=sbrf,dc=ru"
+  useStartTls: false
+  users:
+    filter: "(objectClass=person)"
+    nameAttr: "uid"
+  groups:
+    filter: "(objectClass=posixgroup)"
+    nameAttr: "cn"
+    memberAttr: "member"
+
+istio:
+  egressGateway:
+    tls:
+      secman:
+        rangerCaKey: "ca_chain"
+        fluentbitCaKey: "ca_chain"
+        prometheusRwCaKey: "ca_chain"
+        ipaCaKey: "ldap_ca_chain"
+        accessApiCaKey: "ca_chain"
+
+# Узлы нового кластера. Из короткого имени узла собираются имена PVC и
+# storageClass (см. templates/{om,scm,datanode}/pvc.yaml), поэтому порядок
+# в списке значим: компонент берёт элемент по индексу реплики.
+# TODO(ift2): подтвердить раскладку — сейчас первые пять узлов отданы под
+# om/scm (нужно 3), остальные под datanode. Если у узлов разная разметка
+# дисков или роли закреплены иначе, порядок надо поправить.
+om:
+  replicas: 3
+  resources:
+    requests:
+      memory: "4Gi"
+      cpu: "1"
+    limits:
+      memory: "4Gi"
+      cpu: "2"
+  nodeHostnames:
+    - tsses-kub045741
+    - tsses-kub045742
+    - tsses-kub045743
+    - tsses-kub045744
+    - tsses-kub045745
+
+scm:
+  replicas: 3
+  resources:
+    requests:
+      memory: "4Gi"
+      cpu: "1"
+    limits:
+      memory: "4Gi"
+      cpu: "2"
+  primordialNode: scm0
+  nodeHostnames:
+    - tsses-kub045741
+    - tsses-kub045742
+    - tsses-kub045743
+    - tsses-kub045744
+    - tsses-kub045745
+
+datanode:
+  # TODO(ift2): согласовать число реплик с количеством узлов под датаноды.
+  replicas: 5
+  resources:
+    requests:
+      memory: "6Gi"
+      cpu: "2"
+    limits:
+      memory: "12Gi"
+      cpu: "4"
+  nodeHostnames:
+    - tsses-kub045748
+    - tsses-kub045750
+    - tsses-kub045746
+    - tsses-kub045749
+    - tsses-kub045747
+
+recon:
+  enabled: false
+  replicas: 1
+  resources:
+    requests:
+      memory: "4Gi"
+      cpu: "1"
+    limits:
+      memory: "4Gi"
+      cpu: "2"
+  ingress:
+    enabled: true
+    secman:
+      tls: true
+
+s3g:
+  replicas: 1
+  resources:
+    requests:
+      memory: "4Gi"
+      cpu: "1"
+    limits:
+      memory: "4Gi"
+      cpu: "2"
+  hpa:
+    enabled: true
+    minReplicas: 1
+    maxReplicas: 10
+  ingress:
+    enabled: true
+    secman:
+      tls: true
+
+hue:
+  enabled: false
+  image:
+    repository: hue@sha256
+    tag: a84d1af164447f29fafbacb3c73f518ea075458f0ec85c1cdc784ad129bc9bd3
+  resources:
+    requests:
+      memory: "2Gi"
+      cpu: "500m"
+    limits:
+      memory: "2Gi"
+      cpu: "1"
+  ingress:
+    enabled: true
+    secman:
+      tls: true
+  database:
+    # TODO(ift2): адреса БД нового кластера — у каждого кластера своя,
+    # значения существующего ift здесь оставлять НЕЛЬЗЯ.
+    hosts: []
+    port: 5433
+    name: hue
+    user: ""   # TODO(ift2): пользователь БД, вида ci<CI-код>_pg_ozone_z
+    password: ''
+  secman:
+    dbPasswordKey: hue_db_password
+    sessionSecretKey: hue_session_secret_key
+
+hiveMetastore:
+  enabled: true
+  replicas: 1
+  component: hivemetastore
+  serviceName: hivemetastore
+  image:
+    repository: hive-metastore@sha256
+    tag: 25064f89325ae4721e854b348be40a12378df97ba4c9b5b1f7bc6be34a867fd1
+  resources:
+    requests:
+      memory: "2Gi"
+      cpu: "500m"
+    limits:
+      memory: "2Gi"
+      cpu: "1"
+  service:
+    thriftPort: 9083
+  database:
+    # TODO(ift2): см. комментарий выше — адреса БД нового кластера.
+    hosts: []
+    port: 5433
+    name: hive
+    user: ""   # TODO(ift2): пользователь БД
+    password: ''
+  secman:
+    path: A/CI07978178/OSH/SDPCOMPUTE/KV/ozone
+    dbPasswordKey: hive_db_password
+
+ranger:
+  enabled: true
+  # In-mesh URL: HTTP, port 80. Egress Gateway делает mTLS origination
+  # к настоящему https://ranger... (клиентский cert+key+CA из выдачи
+  # SBERCA, см. istio.egressGateway.tls.secman.rangerMtls).
+  policyAdminUrl: "http://ranger.qa.df.sbrf.ru"
+  ozone:
+    # TODO(ift2): имя сервиса Ozone, зарегистрированное в Ranger. Своё для
+    # каждого кластера — иначе политики двух кластеров смешаются.
+    serviceName: ""
+  ipa:
+    enabled: true
+    # LDAP остаётся источником групп, пока не выдан доступ к AccessAPI.
+    # Переключение — source: accessapi (см. ниже), одна строка.
+    url: "ldap://tvlds-acc000035.qa.df.sbrf.ru:636"
+    baseDn: "dc=qa,dc=df,dc=sbrf,dc=ru"
+    secman:
+      bindDnKey: hue_ldap_bind_dn
+      bindPasswordKey: hue_ldap_bind_password
+    accessApi:
+      url: "http://dataapi-mtls.qa.df.sbrf.ru"
+      auth: gateway
+    # TODO(ift2): выставить source: accessapi ПОСЛЕ того, как
+    #   1) в образе окажется плагин с поддержкой accessapi (иначе OM упадёт), и
+    #   2) СУДиС зарегистрирует CN сертификата egress-гейтвея этого кластера:
+    #      egressgateway-ozone-<namespace>.apps.behe4mln.k8s.delta.sbrf.ru
+    #      — CN зависит от домена, поэтому регистрация нужна отдельная от ift.
+
+cli:
+  image:
+    repository: ozone-cli@sha256
+    tag: ff9e36ed56729ee53c91bf5ee8fcb5fec24a4aa2f886a6fcb76ec41f8f55b501
+  secman:
+    path: A/CI07978178/OSH/SDPCOMPUTE/KV/ozone
+    keytabName: ozone_cli_admin_keytab_b64
+
+prometheus:
+  enabled: true
+  image:
+    repository: prometheus@sha256
+    tag: "81bbd12aacf14664a039ee954033689a5be1f320a8c75d1e5d627a5b3a05600a"
+  ingress:
+    enabled: false
+  resources:
+    requests:
+      cpu: 100m
+      memory: 100Mi
+      ephemeral-storage: 500Mi
+    limits:
+      cpu: 200m
+      memory: 180Mi
+      ephemeral-storage: 500Mi
+  storage:
+    sizeLimit: 4500M
+  # OrgID — must match X-Scope-OrgID header in remoteWrite
+  remoteWriteId: ozonedelta
+  remoteWrite:
+    # In-mesh URL: HTTP, egress gateway делает mTLS origination
+    # к настоящему https://rw-selfservice... (клиентский cert+key+CA из
+    # выдачи SBERCA, см. istio.egressGateway.tls.secman.prometheusRwMtls).
+    - url: http://rw-selfservice.delta.sbrf.ru/api/v1/push
+      remote_timeout: 30s
+      headers:
+        X-Scope-OrgID: ozonedelta
+  federate:
+    enabled: true
+    url: "http://metrics.behe4mln.k8s.delta.sbrf.ru:8481"
+
+fluentBit:
+  enabled: true
+  image:
+    repository: fluent-bit@sha256
+    tag: 9d2d9adbce561b69e534ee91326e6b526c312f92f612ff6fd0fdd9aa599d83f3
+  # TODO(ift2): AppID системы логирования для нового кластера — выдаёт
+  # команда restlogs, вида SPD_OZONE-CI<...>-CI<...>-<timestamp>.
+  appId: ""
+  restlogsHost: tvlss-log000003.dev.df.sbrf.ru
